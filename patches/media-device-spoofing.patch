diff --git a/dom/media/webrtc/MediaEngineFake.cpp b/dom/media/webrtc/MediaEngineFake.cpp
index 8123aa05e5..c8adaff52b 100644
--- a/dom/media/webrtc/MediaEngineFake.cpp
+++ b/dom/media/webrtc/MediaEngineFake.cpp
@@ -4,6 +4,9 @@
 
 #include "MediaEngineFake.h"
 
+#include "MaskConfig.hpp"
+#include "AudioDeviceInfo.h"
+
 #include "AudioSegment.h"
 #include "FakeVideoSource.h"
 #include "ImageContainer.h"
@@ -587,6 +590,70 @@ void MediaEngineFake::EnumerateDevices(
   using IsScary = MediaDevice::IsScary;
   using OsPromptable = MediaDevice::OsPromptable;
 
+  // Camoufox: the identity's devices. Counts from mediaDevices:{micros,
+  // webcams,speakers}; labels and groups from the aligned *Labels / *Groups
+  // lists (a sound card's microphone and speakers share a group, a webcam
+  // and its microphone share one, as their groupId does on a real machine).
+  // Raw ids are anonymised per origin by MediaManager exactly like real ones.
+  if (MaskConfig::GetBool("mediaDevices:enabled")) {
+    auto pick = [](const std::vector<std::string>& list, uint32_t i,
+                   const nsString& fallback) -> nsString {
+      if (i < list.size()) {
+        return NS_ConvertUTF8toUTF16(list[i].c_str());
+      }
+      return fallback;
+    };
+    auto rawId = [](const char* kind, uint32_t i) -> nsString {
+      nsString id;
+      id.AppendPrintf("camou-%s-%u", kind, i);
+      return id;
+    };
+    if (aMediaSink == MediaSinkEnum::Speaker) {
+      const uint32_t n =
+          MaskConfig::GetUint32("mediaDevices:speakers").value_or(1);
+      const auto labels = MaskConfig::GetStringList("mediaDevices:speakerLabels");
+      const auto groups = MaskConfig::GetStringList("mediaDevices:speakerGroups");
+      for (uint32_t i = 0; i < n; ++i) {
+        RefPtr info = new AudioDeviceInfo(
+            nullptr, pick(labels, i, u""_ns),
+            pick(groups, i, rawId("audio-group", i)), u""_ns,
+            CUBEB_DEVICE_TYPE_OUTPUT, CUBEB_DEVICE_STATE_ENABLED,
+            CUBEB_DEVICE_PREF_ALL, CUBEB_DEVICE_FMT_ALL, CUBEB_DEVICE_FMT_S16NE,
+            2, 44100, 44100, 44100, 128, 128);
+        aDevices->EmplaceBack(new MediaDevice(this, info, rawId("spk", i)));
+      }
+      return;
+    }
+    if (aMediaSource == MediaSourceEnum::Camera) {
+      const uint32_t n =
+          MaskConfig::GetUint32("mediaDevices:webcams").value_or(1);
+      const auto labels = MaskConfig::GetStringList("mediaDevices:webcamLabels");
+      const auto groups = MaskConfig::GetStringList("mediaDevices:webcamGroups");
+      for (uint32_t i = 0; i < n; ++i) {
+        aDevices->EmplaceBack(new MediaDevice(
+            this, aMediaSource, pick(labels, i, FakeVideoName()),
+            rawId("cam", i), pick(groups, i, rawId("video-group", i)),
+            IsScary::No, OsPromptable::No));
+      }
+      return;
+    }
+    if (aMediaSource == MediaSourceEnum::Microphone) {
+      const uint32_t n =
+          MaskConfig::GetUint32("mediaDevices:micros").value_or(1);
+      const auto labels =
+          MaskConfig::GetStringList("mediaDevices:microphoneLabels");
+      const auto groups =
+          MaskConfig::GetStringList("mediaDevices:microphoneGroups");
+      for (uint32_t i = 0; i < n; ++i) {
+        aDevices->EmplaceBack(new MediaDevice(
+            this, aMediaSource, pick(labels, i, u"Default Audio Device"_ns),
+            rawId("mic", i), pick(groups, i, rawId("audio-group", i)),
+            IsScary::No, OsPromptable::No));
+      }
+      return;
+    }
+  }
+
   if (aMediaSink == MediaSinkEnum::Speaker) {
     NS_WARNING("No default implementation for MediaSinkEnum::Speaker");
   }
