+// Reads the proxy's reply to a CONNECT request that data was sent behind. It
+// is the handshake's and never reaches the layer above. A refusal is the error
+// nsSocketTransport reports for one met while connecting.
+static bool ReadAwaitedReply(PRFileDesc* fd) {
+  nsSOCKSSocketInfo* info = (nsSOCKSSocketInfo*)fd->secret;
+  while (info && info->AwaitsReply()) {
+    if (info->DoHandshake(fd->lower) != PR_SUCCESS) {
+      if (PR_GetError() == PR_UNKNOWN_ERROR && PR_GetOSError()) {
+        PR_SetError(PR_GetOSError(), 0);
+      }
+      return false;
+    }
+  }
+  return true;
+}
+
+static int32_t nsSOCKSIOLayerRead(PRFileDesc* fd, void* buf, int32_t amount) {
+  if (!ReadAwaitedReply(fd)) return -1;
+  return fd->lower->methods->read(fd->lower, buf, amount);
+}
+
+static int32_t nsSOCKSIOLayerRecv(PRFileDesc* fd, void* buf, int32_t amount,
+                                  int flags, PRIntervalTime timeout) {
+  if (!ReadAwaitedReply(fd)) return -1;
+  return fd->lower->methods->recv(fd->lower, buf, amount, flags, timeout);
+}
+
 static PRStatus nsSOCKSIOLayerClose(PRFileDesc* fd) {
   nsSOCKSSocketInfo* info = (nsSOCKSSocketInfo*)fd->secret;
   PRDescIdentity id = PR_GetLayersIdentity(fd);
