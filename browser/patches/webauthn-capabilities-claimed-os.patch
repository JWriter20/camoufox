+// Camoufox: stock decides the platform-dependent capabilities below at compile
+// time (XP_WIN/XP_MACOSX), so a Linux build claiming Windows answered Linux's
+// false for largeBlob, hybridTransport, passkeyPlatformAuthenticator and
+// userVerifyingPlatformAuthenticator, where stock Windows says true. Answer for
+// the OS the caller's context presents; the host's own when it presents none.
+static MaskConfig::SpoofedOS CapabilitiesOS(const GlobalObject& aGlobal) {
+  nsIGlobalObject* global = xpc::CurrentNativeGlobal(aGlobal.Context());
+  nsIPrincipal* principal = global ? global->PrincipalOrNull() : nullptr;
+  const auto os = principal ? NavigatorManager::GetSpoofedOS(
+                                  RoverfoxStorageManager::UserContextId(principal))
+                            : MaskConfig::GetSpoofedOS();
+  if (os == MaskConfig::SpoofedOS::None || os == MaskConfig::SpoofedOS::Other) {
+    return MaskConfig::HostOS();
+  }
+  return os;
+}
