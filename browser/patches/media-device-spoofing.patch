+// Camoufox: what an identity camera reports. A real camera's capabilities are
+// the largest width, height and frame rate among its capture modes, with a
+// floor of 2 (MediaEngineRemoteVideoSource::ChooseCapability), and it has a
+// facing mode only where the OS names it (GetFacingMode: Windows reads
+// "Front"/"Rear" from the label; macOS and Linux never report one).
+struct IdentityCamera {
+  int32_t mMaxWidth;
+  int32_t mMaxHeight;
+  int32_t mMaxFrameRate;
+  Maybe<nsString> mFacingMode;
+};
+
+// Index i of an identity device's raw id "camou-<kind>-<i>".
+static Maybe<uint32_t> IdentityDeviceIndex(const nsString& aRawId,
+                                           const char* aKind) {
+  nsAutoString prefix;
+  prefix.AppendPrintf("camou-%s-", aKind);
+  if (!StringBeginsWith(aRawId, prefix)) {
+    return Nothing();
+  }
+  nsAutoString rest(Substring(aRawId, prefix.Length()));
+  nsresult rv;
+  const int32_t index = rest.ToInteger(&rv);
+  if (NS_FAILED(rv) || index < 0) {
+    return Nothing();
+  }
+  return Some(static_cast<uint32_t>(index));
+}
+
+// Entry aIndex of the numeric list at aKey, when it is an integer in
+// [aMin, aMax]; aFallback otherwise.
+static int32_t IdentityListValue(std::string_view aKey, uint32_t aIndex,
+                                 int32_t aFallback, int32_t aMin,
+                                 int32_t aMax) {
+  const auto* list = MaskConfig::Find(aKey);
+  if (list && list->is_array() && aIndex < list->size()) {
+    const auto& value = (*list)[aIndex];
+    if (value.is_number_integer() || value.is_number_unsigned()) {
+      const int64_t n = value.get<int64_t>();
+      if (n >= aMin && n <= aMax) {
+        return static_cast<int32_t>(n);
+      }
+    }
+  }
+  return aFallback;
+}
+
+static IdentityCamera IdentityCameraFor(uint32_t aIndex,
+                                        const nsString& aLabel) {
+  // Without per-camera values: a 720p laptop camera, which is what most
+  // Windows machines carry.
+  IdentityCamera camera{
+      IdentityListValue("mediaDevices:webcamMaxWidths", aIndex, 1280, 2, 8192),
+      IdentityListValue("mediaDevices:webcamMaxHeights", aIndex, 720, 2, 8192),
+      IdentityListValue("mediaDevices:webcamMaxFrameRates", aIndex, 30, 1,
+                        240),
+      Nothing()};
+  MaskConfig::SpoofedOS os = MaskConfig::GetSpoofedOS();
+  if (os == MaskConfig::SpoofedOS::None) {
+    os = MaskConfig::HostOS();
+  }
+  if (os == MaskConfig::SpoofedOS::Windows) {
+    if (aLabel.Find(u"Front"_ns) != kNotFound) {
+      camera.mFacingMode.emplace(
+          NS_ConvertASCIItoUTF16(GetEnumString(VideoFacingModeEnum::User)));
+    } else if (aLabel.Find(u"Rear"_ns) != kNotFound) {
+      camera.mFacingMode.emplace(NS_ConvertASCIItoUTF16(
+          GetEnumString(VideoFacingModeEnum::Environment)));
+    }
+  }
+  return camera;
+}
