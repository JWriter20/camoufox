+// As MediaEngineWebRTCMicrophoneSource::EvaluateSettings: the processing a
+// page asks for, else the prefs' (on by default), AGC and NS only with AEC;
+// the channel count asked for, else the device's, within [1, device max].
+nsresult MediaEngineFakeAudioSource::EvaluateIdentitySettings(
+    const dom::MediaTrackConstraints& aConstraints,
+    const MediaEnginePrefs& aPrefs, const char** aOutBadConstraint) {
+  NormalizedConstraints normalized(aConstraints);
+  FlattenedConstraints c(normalized);
+  const bool aec = c.mEchoCancellation.Get(aPrefs.mAecOn);
+  const bool agc = c.mAutoGainControl.Get(aPrefs.mAgcOn && aec);
+  const bool noise = c.mNoiseSuppression.Get(aPrefs.mNoiseOn && aec);
+  const int32_t maxChannels = *mIdentityChannels;
+  if (c.mChannelCount.mMin > maxChannels) {
+    if (aOutBadConstraint) {
+      *aOutBadConstraint = "channelCount";
+    }
+    return NS_ERROR_FAILURE;
+  }
+  int32_t channels = aPrefs.mChannels <= 0 ? maxChannels : aPrefs.mChannels;
+  channels = c.mChannelCount.Get(std::min(channels, maxChannels));
+  channels = std::clamp(channels, 1, maxChannels);
+  mChannels = static_cast<uint32_t>(channels);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      __func__, [settings = mSettings, aec, agc, noise, channels] {
+        settings->mEchoCancellation.Value() = aec;
+        settings->mAutoGainControl.Value() = agc;
+        settings->mNoiseSuppression.Value() = noise;
+        settings->mChannelCount.Value() = channels;
+      }));
+  return NS_OK;
+}
