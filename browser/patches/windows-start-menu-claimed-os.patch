+// Camoufox: the Windows shell's Start menu, for a Windows identity on another
+// OS. On Windows a Win key released with no other key in between opens Start,
+// which takes the foreground: the page sees the key's keydown, never its keyup,
+// and the window blurs. Until Start is dismissed the keyboard is Start's, and
+// a click into the window first only dismisses Start. Measured with SendInput
+// on win-i9 (Windows 11 26200, stock Firefox 158.0.1, it6 jprobe, 2-3 runs
+// each, every run alike):
+//  - Win tap: keydown Meta, blur, hasFocus false, no keyup (state Start).
+//  - Win held while clicking, then released: the same (state Search).
+//  - Start + click: focus then blur at once, no pointer events (-> Search).
+//  - Start + a key: nothing reaches the page (-> Search).
+//  - Search + click: focus, then the click's events; Start is gone.
+//  - Start + Escape or a Win tap: focus comes back; no key events.
+//  - Search + a Win tap: Start again; + Escape or Alt: nothing changes.
+// visibilityState stays visible throughout. Input from the automation driver
+// (Juggler) never reaches these handlers, as it never reaches the shell.
+enum class ClaimedShell { Closed, Start, Search };
+static ClaimedShell sClaimedShell = ClaimedShell::Closed;
+static bool sClaimedWinDown = false;     // a Win key is held
+static bool sClaimedWinChord = false;    // another key went down while it was
+static bool sClaimedWinClick = false;    // a button went down while it was
+static bool sClaimedEatRelease = false;  // the release of a click Start took
+
+static bool ClaimsWindowsShell() {
+  static const bool sClaims =
+      MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows &&
+      MaskConfig::HostOS() != MaskConfig::SpoofedOS::Windows;
+  return sClaims;
+}
+
+static bool IsWinKey(const GdkEventKey* aEvent) {
+  return aEvent->keyval == GDK_KEY_Super_L || aEvent->keyval == GDK_KEY_Super_R;
+}
+
+// Tells every page in the window that the shell holds the foreground, so the
+// automation's page focus emulation (overrideHasFocus: hasFocus() always true,
+// no blur when focus leaves, dom/base/Document.cpp, nsFocusManager.cpp) yields
+// to it as Windows blurs. Set before the deactivation it explains: both reach
+// the content processes over PContent, in order.
+static void ClaimedShellForeground(nsWindow* aTop, bool aHeld) {
+  using mozilla::dom::BrowsingContext;
+  using mozilla::dom::CanonicalBrowsingContext;
+  nsIWidgetListener* listener = aTop ? aTop->GetWidgetListener() : nullptr;
+  PresShell* presShell = listener ? listener->GetPresShell() : nullptr;
+  mozilla::dom::Document* doc = presShell ? presShell->GetDocument() : nullptr;
+  BrowsingContext* bc = doc ? doc->GetBrowsingContext() : nullptr;
+  if (!bc) {
+    return;
+  }
+  RefPtr<CanonicalBrowsingContext> top =
+      bc->Canonical()->TopCrossChromeBoundary();
+  (void)top->SetClaimedShellForeground(aHeld);
+  top->CallOnTopDescendants(
+      [aHeld](CanonicalBrowsingContext* aContext) {
+        (void)aContext->SetClaimedShellForeground(aHeld);
+        return mozilla::CallState::Continue;
+      },
+      CanonicalBrowsingContext::TopDescendantKind::All);
+}
+
+// Start takes the foreground: the window deactivates as when another
+// application is focused. aTop: the container window, which GTK's focus
+// events reach.
+static void ClaimedShellOpen(nsWindow* aTop, ClaimedShell aState) {
+  sClaimedShell = aState;
+  if (RefPtr<nsWindow> top = aTop) {
+    ClaimedShellForeground(top, true);
+    top->OnContainerFocusOutEvent(nullptr);
+  }
+}
+
+static void ClaimedShellClose(nsWindow* aTop) {
+  sClaimedShell = ClaimedShell::Closed;
+  if (RefPtr<nsWindow> top = aTop) {
+    ClaimedShellForeground(top, false);
+    top->OnContainerFocusInEvent(nullptr);
+  }
+}
+
+// Whether the shell took this key event (true: the page must not see it).
+static bool ClaimedShellKey(nsWindow* aTop, const GdkEventKey* aEvent,
+                            bool aPress) {
+  if (!ClaimsWindowsShell()) {
+    return false;
+  }
+  const bool win = IsWinKey(aEvent);
+  if (aPress) {
+    if (win) {
+      if (!sClaimedWinDown) {
+        sClaimedWinDown = true;
+        sClaimedWinChord = sClaimedWinClick = false;
+      }
+    } else if (sClaimedWinDown) {
+      sClaimedWinChord = true;
+    }
+    if (sClaimedShell == ClaimedShell::Start && !win &&
+        aEvent->keyval != GDK_KEY_Escape) {
+      sClaimedShell = ClaimedShell::Search;  // typed into Start
+    }
+    return sClaimedShell != ClaimedShell::Closed;
+  }
+  if (win) {
+    const bool tap = sClaimedWinDown && !sClaimedWinChord;
+    sClaimedWinDown = false;
+    if (sClaimedShell == ClaimedShell::Closed) {
+      if (!tap) {
+        return false;
+      }
+      ClaimedShellOpen(aTop, sClaimedWinClick ? ClaimedShell::Search
+                                              : ClaimedShell::Start);
+      return true;
+    }
+    if (tap) {
+      if (sClaimedShell == ClaimedShell::Start) {
+        ClaimedShellClose(aTop);
+      } else {
+        sClaimedShell = ClaimedShell::Start;
+      }
+    }
+    return true;
+  }
+  if (sClaimedShell == ClaimedShell::Start &&
+      aEvent->keyval == GDK_KEY_Escape) {
+    ClaimedShellClose(aTop);
+    return true;
+  }
+  return sClaimedShell != ClaimedShell::Closed;
+}
+
 void nsWindow::OnButtonPressEvent(GdkEventButton* aEvent) {
   LOG("Button %u press\n", aEvent->button);
 
+  // A Windows identity's Start menu (ClaimedShellKey): a click into the
+  // window while Start is open only dismisses it, and the search pane that
+  // replaces it keeps the foreground; the next click activates the window.
+  if (ClaimsWindowsShell()) {
+    if (sClaimedWinDown) {
+      sClaimedWinClick = true;
+    }
+    if (sClaimedShell == ClaimedShell::Start) {
+      sClaimedShell = ClaimedShell::Search;
+      sClaimedEatRelease = true;
+      if (RefPtr<nsWindow> top = GetContainerWindow()) {
+        top->OnContainerFocusInEvent(nullptr);
+        top->OnContainerFocusOutEvent(nullptr);
+      }
+      return;
+    }
+    if (sClaimedShell == ClaimedShell::Search) {
+      // Activated below, as for any click into an inactive window.
+      sClaimedShell = ClaimedShell::Closed;
+      ClaimedShellForeground(GetContainerWindow(), false);
+    }
+  }
+
   SetLastPointerDownEvent((GdkEvent*)aEvent);
   mLastMouseCoordinates.Set(aEvent);
 
@@ -3435,6 +3588,11 @@
 void nsWindow::OnButtonReleaseEvent(GdkEventButton* aEvent) {
   LOG("Button %u release\n", aEvent->button);
 
+  if (sClaimedEatRelease) {  // its press only dismissed Start
+    sClaimedEatRelease = false;
+    return;
+  }
+
   SetLastPointerDownEvent(nullptr);
   mLastMouseCoordinates.Set(aEvent);
 
@@ -3518,6 +3676,12 @@
