   LOG("OnKeyReleaseEvent");
+  if (ClaimedShellKey(GetContainerWindow(), aEvent, false)) {
+    return TRUE;
+  }
   if (NS_WARN_IF(!KeymapWrapper::HandleKeyReleaseEvent(this, aEvent))) {
     return FALSE;
   }
