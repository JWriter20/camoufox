   LOG("OnContainerFocusOutEvent");
 
+  if (aEvent && sClaimedShell != ClaimedShell::Closed) {
+    sClaimedShell = ClaimedShell::Closed;
+    ClaimedShellForeground(this, false);
+  }
+
   if (IsTopLevelWidget()) {
     // Rollup menus when a window is focused out unless a drag is occurring.
     // This check is because drags grab the keyboard and cause a focus out on
@@ -3684,12 +3853,18 @@
 gboolean nsWindow::OnKeyPressEvent(GdkEventKey* aEvent) {
   LOG("OnKeyPressEvent");
 
+  if (ClaimedShellKey(GetContainerWindow(), aEvent, true)) {
+    return TRUE;
+  }
   KeymapWrapper::HandleKeyPressEvent(this, aEvent);
   return TRUE;
 }
 
