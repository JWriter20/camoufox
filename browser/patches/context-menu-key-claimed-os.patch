diff --git a/widget/gtk/nsGtkKeyUtils.cpp b/widget/gtk/nsGtkKeyUtils.cpp
--- a/widget/gtk/nsGtkKeyUtils.cpp
+++ b/widget/gtk/nsGtkKeyUtils.cpp
@@ -1540,6 +1540,19 @@ bool KeymapWrapper::DispatchKeyDownOrKey
   return dispatched;
 }
 
+// Camoufox: whether the ContextMenu key opens the context menu on its release,
+// as on Windows. GTK dispatches eContextMenu with the key's press, so the menu
+// takes the keyboard before the key comes up and the page never sees its keyup.
+// Windows' DefWindowProc sends WM_CONTEXTMENU once VK_APPS is released: stock
+// Firefox 158.0.1 on win-i9 (cfparity input.window.menukey) fires keydown,
+// keyup, then contextmenu, all at the focused element.
+static bool ClaimsWindowsContextMenuKey(const GdkEventKey* aEvent) {
+  return MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows &&
+         MaskConfig::HostOS() != MaskConfig::SpoofedOS::Windows &&
+         KeymapWrapper::ComputeDOMKeyNameIndex(aEvent) ==
+             KEY_NAME_INDEX_ContextMenu;
+}
+
 /* static */
 bool KeymapWrapper::MaybeDispatchContextMenuEvent(nsWindow* aWindow,
                                                   const GdkEventKey* aEvent) {
@@ -1794,6 +1807,12 @@ void KeymapWrapper::HandleKeyPressEvent(
       break;
   }
 
+  // A Windows identity opens the context menu when the key is released
+  // (HandleKeyReleaseEvent); the press dispatches no keypress either way.
+  if (ClaimsWindowsContextMenuKey(aGdkKeyEvent)) {
+    return;
+  }
+
   // before we dispatch a key, check if it's the context menu key.
   // If so, send a context menu key event instead.
   if (MaybeDispatchContextMenuEvent(aWindow, aGdkKeyEvent)) {
@@ -1893,6 +1912,13 @@ bool KeymapWrapper::HandleKeyReleaseEven
           ("  HandleKeyReleaseEvent(), dispatched eKeyUp event "
            "(isCancelled=%s)",
            TrueOrFalse(isCancelled)));
+
+  // A consumed WM_KEYUP never reaches DefWindowProc, which is what sends
+  // WM_CONTEXTMENU; a consumed keydown does not stop it.
+  if (!isCancelled && !aWindow->IsDestroyed() &&
+      ClaimsWindowsContextMenuKey(aGdkKeyEvent)) {
+    MaybeDispatchContextMenuEvent(aWindow, aGdkKeyEvent);
+  }
   return true;
 }
 
