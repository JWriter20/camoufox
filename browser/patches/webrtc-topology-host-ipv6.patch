diff --git a/dom/media/webrtc/transport/third_party/nICEr/src/stun/addrs.cpp b/dom/media/webrtc/transport/third_party/nICEr/src/stun/addrs.cpp
--- a/dom/media/webrtc/transport/third_party/nICEr/src/stun/addrs.cpp
+++ b/dom/media/webrtc/transport/third_party/nICEr/src/stun/addrs.cpp
@@ -72,6 +72,24 @@
   return count;
 }
 
+int
+nr_stun_is_claimed_host_addr(nr_local_addr addrs[], int count, int i)
+{
+    if (addrs[i].addr.ip_version != NR_IPV6 ||
+        !nr_transport_addr_is_loopback(&addrs[i].addr)) {
+      return 0;
+    }
+    for (int j = 0; j < count; ++j) {
+      if (j != i &&
+          !strncmp(addrs[i].addr.ifname, addrs[j].addr.ifname,
+                   sizeof(addrs[i].addr.ifname)) &&
+          !nr_transport_addr_is_loopback(&addrs[j].addr)) {
+        return 1;
+      }
+    }
+    return 0;
+}
