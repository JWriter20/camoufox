+/* static */
+Maybe<NrIceStunAddr> NrIceStunAddr::ClaimedHostIPv6(
+    const nsTArray<NrIceStunAddr>& aAddrs) {
+  const NrIceStunAddr* primary = nullptr;
+  for (const auto& a : aAddrs) {
+    nr_local_addr local;
+    a.toNrLocalAddr(local);
+    if (nr_transport_addr_is_loopback(&local.addr) ||
+        nr_transport_addr_is_link_local(&local.addr)) {
+      continue;
+    }
+    if (local.addr.ip_version == NR_IPV6) {
+      // Global unicast (2000::/3): the host's own default route finds it.
+      if ((a.address_.as<IPv6>().address[0] & 0xE0) == 0x20) {
+        return Nothing();
+      }
+      continue;
+    }
+    // A wired or Wi-Fi interface over a VPN or bridge when there is one.
+    const bool physical =
+        (static_cast<int>(a.interface_type_) &
+         (static_cast<int>(InterfaceType::Wired) |
+          static_cast<int>(InterfaceType::Wifi))) != 0;
+    if (!primary || (physical && !(static_cast<int>(primary->interface_type_) &
+                                   (static_cast<int>(InterfaceType::Wired) |
+                                    static_cast<int>(InterfaceType::Wifi))))) {
+      primary = &a;
+    }
+  }
+  if (!primary) {
+    return Nothing();
+  }
+  NrIceStunAddr claimed(*primary);
+  IPv6 loopback{};
+  loopback.address[15] = 1;
+  claimed.address_ = AsVariant(loopback);
+  claimed.temporary_ = true;
+  return Some(claimed);
+}
+
 }  // namespace mozilla
