@@ -0,0 +1,309 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "WebrtcUdpAssociation.h"
+
+#include "mozilla/net/ProxyConfigLookup.h"
+#include "mozilla/Logging.h"
+#include "mozilla/net/WebrtcProxyConfig.h"
+#include "nr_socket_proxy_config.h"
+#include "nsIProtocolProxyService.h"
+#include "nsIProxyInfo.h"
+#include "nsISocketTransport.h"
+#include "nsISocketTransportService.h"
+#include "nsNetCID.h"
+#include "nsServiceManagerUtils.h"
+#include "nsThreadUtils.h"
+
+namespace mozilla::net {
+
+static LazyLogModule gUdpAssociationLog("WebrtcUdpAssociation");
+#define UDP_ASSOC_LOG(...) \
+  MOZ_LOG(gUdpAssociationLog, LogLevel::Info, (__VA_ARGS__))
+
+NS_IMPL_ISUPPORTS(WebrtcUdpAssociation, nsIInputStreamCallback,
+                  nsIOutputStreamCallback)
+
+WebrtcUdpAssociation::WebrtcUdpAssociation(
+    WebrtcUdpAssociationOwner* aOwner,
+    const std::shared_ptr<NrSocketProxyConfig>& aConfig)
+    : mOwner(aOwner),
+      mConfig(aConfig),
+      mSocketThread(do_GetService(NS_SOCKETTRANSPORTSERVICE_CONTRACTID)) {}
+
+WebrtcUdpAssociation::~WebrtcUdpAssociation() = default;
+
+// static
+already_AddRefed<WebrtcUdpAssociation> WebrtcUdpAssociation::Start(
+    WebrtcUdpAssociationOwner* aOwner,
+    const std::shared_ptr<NrSocketProxyConfig>& aConfig) {
+  RefPtr<WebrtcUdpAssociation> association =
+      new WebrtcUdpAssociation(aOwner, aConfig);
+  NS_DispatchToMainThread(
+      NewRunnableMethod("WebrtcUdpAssociation::Lookup", association,
+                        &WebrtcUdpAssociation::Lookup));
+  return association.forget();
+}
+
+void WebrtcUdpAssociation::Lookup() {
+  MOZ_ASSERT(NS_IsMainThread());
+  RefPtr<WebrtcUdpAssociation> self = this;
+  auto onProxy = [self](nsIProxyInfo* aInfo, nsresult aStatus) {
+    nsCString type, host, username, password;
+    int32_t port = 0;
+    if (NS_SUCCEEDED(aStatus) && aInfo) {
+      aInfo->GetType(type);
+      aInfo->GetHost(host);
+      aInfo->GetPort(&port);
+      aInfo->GetUsername(username);
+      aInfo->GetPassword(password);
+    }
+    self->mSocketThread->Dispatch(NS_NewRunnableFunction(
+        "WebrtcUdpAssociation::OnProxy",
+        [self, type, host, port, username, password]() {
+          self->OnProxy(type, host, port, username, password);
+        }));
+  };
+  // The same resolution as WebrtcTCPSocket's, for the page's own URI.
+  nsresult rv = ProxyConfigLookup::Create(
+      std::function<void(nsIProxyInfo*, nsresult)>(onProxy), nullptr,
+      nsIProtocolProxyService::RESOLVE_PREFER_HTTPS_PROXY |
+          nsIProtocolProxyService::RESOLVE_ALWAYS_TUNNEL,
+      false, nullptr, Some(mConfig->GetConfig().loadInfoArgs()));
+  if (NS_FAILED(rv)) {
+    onProxy(nullptr, rv);
+  }
+}
+
+void WebrtcUdpAssociation::OnProxy(const nsCString& aType,
+                                   const nsCString& aHost, int32_t aPort,
+                                   const nsCString& aUsername,
+                                   const nsCString& aPassword) {
+  MOZ_ASSERT(mSocketThread->IsOnCurrentThread());
+  if (mStep != Step::Lookup) {
+    return;
+  }
+  // "socks" is SOCKS5; "socks4" has no UDP.
+  if (!aType.EqualsLiteral("socks")) {
+    UDP_ASSOC_LOG("WebrtcUdpAssociation %p: proxy type '%s' carries no UDP",
+                  this, aType.get());
+    return Fail("the proxy is not SOCKS5");
+  }
+  if (aUsername.Length() > 255 || aPassword.Length() > 255) {
+    return Fail("credentials longer than SOCKS5 allows");
+  }
+  mUsername = aUsername;
+  mPassword = aPassword;
+
+  nsresult rv;
+  nsCOMPtr<nsISocketTransportService> sts =
+      do_GetService(NS_SOCKETTRANSPORTSERVICE_CONTRACTID, &rv);
+  if (NS_SUCCEEDED(rv)) {
+    rv = sts->CreateTransport(nsTArray<nsCString>(), aHost, aPort, nullptr,
+                              nullptr, getter_AddRefs(mTransport));
+  }
+  nsCOMPtr<nsIInputStream> in;
+  nsCOMPtr<nsIOutputStream> out;
+  if (NS_SUCCEEDED(rv)) {
+    rv = mTransport->OpenInputStream(0, 0, 0, getter_AddRefs(in));
+  }
+  if (NS_SUCCEEDED(rv)) {
+    rv = mTransport->OpenOutputStream(nsITransport::OPEN_UNBUFFERED, 0, 0,
+                                      getter_AddRefs(out));
+  }
+  mIn = do_QueryInterface(in);
+  mOut = do_QueryInterface(out);
+  if (NS_FAILED(rv) || !mIn || !mOut) {
+    return Fail("could not connect to the proxy");
+  }
+
+  // Greeting: no authentication, or username/password (RFC 1929) when the
+  // proxy has credentials.
+  mStep = Step::Greeting;
+  Send(mUsername.IsEmpty() ? nsTArray<uint8_t>{5, 1, 0}
+                           : nsTArray<uint8_t>{5, 2, 0, 2});
+  mIn->AsyncWait(this, 0, 0, mSocketThread);
+}
+
+void WebrtcUdpAssociation::Send(const nsTArray<uint8_t>& aBytes) {
+  mOutBuf.AppendElements(aBytes);
+  mOut->AsyncWait(this, 0, 0, mSocketThread);
+}
+
+NS_IMETHODIMP
+WebrtcUdpAssociation::OnOutputStreamReady(nsIAsyncOutputStream* aStream) {
+  if (mStep == Step::Done) {
+    return NS_OK;
+  }
+  while (!mOutBuf.IsEmpty()) {
+    uint32_t written = 0;
+    nsresult rv = mOut->Write(reinterpret_cast<const char*>(mOutBuf.Elements()),
+                              mOutBuf.Length(), &written);
+    if (rv == NS_BASE_STREAM_WOULD_BLOCK) {
+      mOut->AsyncWait(this, 0, 0, mSocketThread);
+      return NS_OK;
+    }
+    if (NS_FAILED(rv)) {
+      Fail("could not write to the proxy");
+      return NS_OK;
+    }
+    mOutBuf.RemoveElementsAt(0, written);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+WebrtcUdpAssociation::OnInputStreamReady(nsIAsyncInputStream* aStream) {
+  if (mStep == Step::Done) {
+    return NS_OK;
+  }
+  while (true) {
+    char buf[512];
+    uint32_t read = 0;
+    nsresult rv = mIn->Read(buf, sizeof(buf), &read);
+    if (rv == NS_BASE_STREAM_WOULD_BLOCK) {
+      break;
+    }
+    // The association lives exactly as long as its control connection.
+    if (NS_FAILED(rv) || read == 0) {
+      Fail("the control connection closed");
+      return NS_OK;
+    }
+    if (mStep != Step::Associated) {
+      mInBuf.AppendElements(reinterpret_cast<uint8_t*>(buf), read);
+    }
+  }
+  Parse();
+  if (mStep != Step::Done) {
+    mIn->AsyncWait(this, 0, 0, mSocketThread);
+  }
+  return NS_OK;
+}
+
+void WebrtcUdpAssociation::Parse() {
+  while (true) {
+    switch (mStep) {
+      case Step::Greeting: {
+        if (mInBuf.Length() < 2) {
+          return;
+        }
+        const uint8_t version = mInBuf[0], method = mInBuf[1];
+        mInBuf.RemoveElementsAt(0, 2);
+        if (version != 5) {
+          return Fail("the proxy does not speak SOCKS5");
+        }
+        if (method == 2 && !mUsername.IsEmpty()) {
+          nsTArray<uint8_t> auth{1, static_cast<uint8_t>(mUsername.Length())};
+          auth.AppendElements(
+              reinterpret_cast<const uint8_t*>(mUsername.get()),
+              mUsername.Length());
+          auth.AppendElement(static_cast<uint8_t>(mPassword.Length()));
+          auth.AppendElements(
+              reinterpret_cast<const uint8_t*>(mPassword.get()),
+              mPassword.Length());
+          mStep = Step::Auth;
+          Send(auth);
+          continue;
+        }
+        if (method != 0) {
+          return Fail("the proxy accepts none of our authentication methods");
+        }
+        break;
+      }
+      case Step::Auth: {
+        if (mInBuf.Length() < 2) {
+          return;
+        }
+        const uint8_t status = mInBuf[1];
+        mInBuf.RemoveElementsAt(0, 2);
+        if (status != 0) {
+          return Fail("the proxy refused the credentials");
+        }
+        break;
+      }
+      case Step::Reply: {
+        if (mInBuf.Length() < 5) {
+          return;
+        }
+        size_t length;
+        switch (mInBuf[3]) {
+          case 1:
+            length = 4 + 4 + 2;
+            break;
+          case 4:
+            length = 4 + 16 + 2;
+            break;
+          default:
+            return Fail("the relay address is not an IP address");
+        }
+        if (mInBuf.Length() < length) {
+          return;
+        }
+        if (mInBuf[0] != 5 || mInBuf[1] != 0) {
+          UDP_ASSOC_LOG("WebrtcUdpAssociation %p: UDP ASSOCIATE refused (%u)",
+                        this, mInBuf[1]);
+          return Fail("the proxy refused UDP ASSOCIATE");
+        }
+        NetAddr relay;
+        if (mInBuf[3] == 1) {
+          relay.inet.family = AF_INET;
+          memcpy(&relay.inet.ip, &mInBuf[4], 4);
+          memcpy(&relay.inet.port, &mInBuf[8], 2);
+        } else {
+          relay.inet6.family = AF_INET6;
+          memcpy(&relay.inet6.ip, &mInBuf[4], 16);
+          memcpy(&relay.inet6.port, &mInBuf[20], 2);
+        }
+        // An unspecified address means the proxy's own (RFC 1928 §6).
+        if (relay.IsIPAddrAny()) {
+          const uint16_t port = relay.inet.port;
+          if (NS_FAILED(mTransport->GetPeerAddr(&relay))) {
+            return Fail("no address for the relay");
+          }
+          relay.inet.port = port;
+        }
+        mInBuf.Clear();
+        mStep = Step::Associated;
+        mOwner->OnRelayReady(relay);
+        return;
+      }
+      default:
+        mInBuf.Clear();
+        return;
+    }
+    // UDP ASSOCIATE, from a sending address the client does not know yet.
+    mStep = Step::Reply;
+    Send(nsTArray<uint8_t>{5, 3, 0, 1, 0, 0, 0, 0, 0, 0});
+  }
+}
+
+void WebrtcUdpAssociation::Fail(const char* aWhy) {
+  UDP_ASSOC_LOG("WebrtcUdpAssociation %p: %s; no UDP leaves for the internet",
+                this, aWhy);
+  WebrtcUdpAssociationOwner* owner = mOwner;
+  Close();
+  if (owner) {
+    owner->OnRelayFailed();
+  }
+}
+
+void WebrtcUdpAssociation::Close() {
+  MOZ_ASSERT(mSocketThread->IsOnCurrentThread());
+  mOwner = nullptr;
+  mStep = Step::Done;
+  if (mIn) {
+    mIn->AsyncWait(nullptr, 0, 0, nullptr);
+    mIn = nullptr;
+  }
+  if (mOut) {
+    mOut->AsyncWait(nullptr, 0, 0, nullptr);
+    mOut = nullptr;
+  }
+  if (mTransport) {
+    mTransport->Close(NS_BASE_STREAM_CLOSED);
+    mTransport = nullptr;
+  }
+}
+
+}  // namespace mozilla::net
