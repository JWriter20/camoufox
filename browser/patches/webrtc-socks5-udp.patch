+#if defined(MOZILLA_INTERNAL_API)
+// RFC 1928 §7: RSV, FRAG, ATYP, then a host name of up to 255 bytes and a port.
+static constexpr size_t kRelayHeaderMax = 4 + 1 + 255 + 2;
+// Datagrams kept while the association is made; a gather sends a handful.
+static constexpr size_t kRelayPendingMax = 64;
+
+NrUdpRelaySocket::NrUdpRelaySocket(
+    const std::shared_ptr<NrSocketProxyConfig>& aConfig)
+    : config_(aConfig) {
+  memset(&relay_addr_, 0, sizeof(relay_addr_));
+}
+
+// The association points back here until it is closed.
+NrUdpRelaySocket::~NrUdpRelaySocket() { EndRelay(); }
+
+int NrUdpRelaySocket::create(nr_transport_addr* addr) {
+  int r = NrSocket::create(addr);
+  if (!r) {
+    association_ = net::WebrtcUdpAssociation::Start(this, config_);
+  }
+  return r;
+}
+
+int NrUdpRelaySocket::sendto(const void* msg, size_t len, int flags,
+                             const nr_transport_addr* to) {
+  ASSERT_ON_THREAD(ststhread_);
+  // A STUN or TURN server given by host name has a placeholder address; the
+  // proxy resolves the name, never this machine.
+  const bool byName = to->fqdn[0] && nr_transport_addr_is_wildcard(to);
+  if (!byName && nr_transport_addr_is_local_network(to)) {
+    return NrSocket::sendto(msg, len, flags, to);
+  }
+  if (IsForbiddenAddress(to)) {
+    return 0;
+  }
+  if (nr_is_stun_request_message((UCHAR*)msg, len) && ShouldDrop(len)) {
+    return R_WOULDBLOCK;
+  }
+  if (state_ == State::Failed) {
+    return R_REJECTED;
+  }
+
+  uint16_t port;
+  if (nr_transport_addr_get_port(to, &port)) {
+    return R_BAD_ARGS;
+  }
+  uint8_t header[kRelayHeaderMax] = {0, 0, 0};
+  size_t h = 3;
+  if (byName) {
+    // The proxy resolves a name to one address of its choosing, so only the
+    // IPv4 socket asks by name, as it alone would on an IPv4 exit.
+    const size_t n = strlen(to->fqdn);
+    if (my_addr_.ip_version != NR_IPV4 || n > 255) {
+      return R_REJECTED;
+    }
+    header[h++] = 3;
+    header[h++] = static_cast<uint8_t>(n);
+    memcpy(header + h, to->fqdn, n);
+    h += n;
+  } else if (to->ip_version == NR_IPV4) {
+    header[h++] = 1;
+    memcpy(header + h, &to->u.addr4.sin_addr.s_addr, 4);
+    h += 4;
+  } else {
+    header[h++] = 4;
+    memcpy(header + h, &to->u.addr6.sin6_addr, 16);
+    h += 16;
+  }
+  const uint16_t nport = htons(port);
+  memcpy(header + h, &nport, 2);
+  h += 2;
+  nsTArray<uint8_t> datagram(h + len);
+  datagram.AppendElements(header, h);
+  datagram.AppendElements(static_cast<const uint8_t*>(msg), len);
+
+  if (state_ == State::Associating) {
+    if (pending_.size() < kRelayPendingMax) {
+      pending_.push_back(std::move(datagram));
+    }
+    return 0;
+  }
+  return relay_->sendto(datagram.Elements(), datagram.Length(), flags,
+                        &relay_addr_);
+}
+
+int NrUdpRelaySocket::recvfrom(void* buf, size_t maxlen, size_t* len,
+                               int flags, nr_transport_addr* from) {
+  ASSERT_ON_THREAD(ststhread_);
+  while (relay_) {
+    recv_buf_.SetLength(kRelayHeaderMax + maxlen);
+    size_t got = 0;
+    nr_transport_addr source;
+    if (relay_->recvfrom(recv_buf_.Elements(), recv_buf_.Length(), &got, flags,
+                         &source)) {
+      break;
+    }
+    const uint8_t* p = recv_buf_.Elements();
+    // Only the relay speaks for the internet, and only unfragmented.
+    if (nr_transport_addr_cmp(&source, &relay_addr_,
+                              NR_TRANSPORT_ADDR_CMP_MODE_ALL) ||
+        got < 4 || p[0] || p[1] || p[2]) {
+      continue;
+    }
+    size_t header;
+    uint16_t nport;
+    if (p[3] == 1 && got >= 10) {
+      uint32_t ip;
+      memcpy(&ip, p + 4, 4);
+      memcpy(&nport, p + 8, 2);
+      nr_ip4_port_to_transport_addr(ntohl(ip), ntohs(nport), IPPROTO_UDP,
+                                    from);
+      header = 10;
+    } else if (p[3] == 4 && got >= 22) {
+      in6_addr ip;
+      memcpy(&ip, p + 4, 16);
+      memcpy(&nport, p + 20, 2);
+      nr_ip6_port_to_transport_addr(&ip, ntohs(nport), IPPROTO_UDP, from);
+      header = 22;
+    } else {
+      continue;
+    }
+    *len = got - header;
+    memcpy(buf, p + header, *len);
+    return 0;
+  }
+  return NrSocket::recvfrom(buf, maxlen, len, flags, from);
+}
+
+int NrUdpRelaySocket::async_wait(int how, NR_async_cb cb, void* cb_arg,
+                                 char* function, int line) {
+  int r = NrSocket::async_wait(how, cb, cb_arg, function, line);
+  if (!r && how == NR_ASYNC_WAIT_READ && relay_) {
+    relay_->async_wait(NR_ASYNC_WAIT_READ, RelayReadable, this, function,
+                       line);
+  }
+  return r;
+}
+
+int NrUdpRelaySocket::cancel(int how) {
+  int r = NrSocket::cancel(how);
+  if (!r && how == NR_ASYNC_WAIT_READ && relay_) {
+    relay_->cancel(NR_ASYNC_WAIT_READ);
+  }
+  return r;
+}
+
+// static
+void NrUdpRelaySocket::RelayReadable(NR_SOCKET s, int how, void* arg) {
+  NrUdpRelaySocket* self = static_cast<NrUdpRelaySocket*>(arg);
+  if (self->poll_flags() & PR_POLL_READ) {
+    self->fire_callback(NR_ASYNC_WAIT_READ);
+  }
+}
+
+void NrUdpRelaySocket::close() {
+  EndRelay();
+  NrSocket::close();
+}
+
+void NrUdpRelaySocket::OnRelayReady(const net::NetAddr& aRelay) {
+  ASSERT_ON_THREAD(ststhread_);
+  nr_transport_addr relay, local;
+  if (nr_netaddr_to_transport_addr(&aRelay, &relay, IPPROTO_UDP)) {
+    return OnRelayFailed();
+  }
+  if (relay.ip_version == NR_IPV4) {
+    nr_ip4_port_to_transport_addr(INADDR_ANY, 0, IPPROTO_UDP, &local);
+  } else {
+    in6_addr any = in6addr_any;
+    nr_ip6_port_to_transport_addr(&any, 0, IPPROTO_UDP, &local);
+  }
+  RefPtr<NrSocket> socket = new NrSocket();
+  if (socket->create(&local)) {
+    return OnRelayFailed();
+  }
+  relay_ = socket;
+  relay_addr_ = relay;
+  state_ = State::Relaying;
+  r_log(LOG_GENERIC, LOG_INFO, "UDP of %s goes through the relay at %s",
+        my_addr_.as_string, relay_addr_.as_string);
+  for (const nsTArray<uint8_t>& datagram : pending_) {
+    relay_->sendto(datagram.Elements(), datagram.Length(), 0, &relay_addr_);
+  }
+  pending_.clear();
+  if (poll_flags() & PR_POLL_READ) {
+    relay_->async_wait(NR_ASYNC_WAIT_READ, RelayReadable, this,
+                       (char*)__FUNCTION__, __LINE__);
+  }
+}
+
+void NrUdpRelaySocket::OnRelayFailed() {
+  r_log(LOG_GENERIC, LOG_INFO,
+        "UDP of %s reaches only the local network: the proxy carries no UDP",
+        my_addr_.as_string);
+  EndRelay();
+}
+
+void NrUdpRelaySocket::EndRelay() {
+  state_ = State::Failed;
+  pending_.clear();
+  if (association_) {
+    association_->Close();
+    association_ = nullptr;
+  }
+  if (relay_) {
+    relay_->close();
+    relay_ = nullptr;
+  }
+}
