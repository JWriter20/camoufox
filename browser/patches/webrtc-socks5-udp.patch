+// Camoufox: what a UDP ASSOCIATE tells the ICE socket it serves, on the socket
+// thread. OnRelayFailed() ends it: a proxy that is not SOCKS5, one that
+// refuses the association, or a control connection that closed.
+class WebrtcUdpAssociationOwner {
+ public:
+  virtual void OnRelayReady(const NetAddr& aRelay) = 0;
+  virtual void OnRelayFailed() = 0;
+
+ protected:
+  virtual ~WebrtcUdpAssociationOwner() = default;
+};
+
+// Camoufox: a SOCKS5 UDP ASSOCIATE (RFC 1928 §7) on the proxy of the tab an
+// ICE socket belongs to, for the life of that socket. The parent resolves the
+// proxy with the tab's load info, as for the tab's own loads, so a context's
+// proxy filter and its credentials apply. The control connection then runs
+// from this process, where the datagrams are sent, so the relay sees both
+// from the same address.
+class WebrtcUdpAssociation final : public nsIInputStreamCallback,
+                                   public nsIOutputStreamCallback {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_NSIINPUTSTREAMCALLBACK
+  NS_DECL_NSIOUTPUTSTREAMCALLBACK
+
+  // On the socket thread. aOwner must call Close() before it goes away.
+  static already_AddRefed<WebrtcUdpAssociation> Start(
+      WebrtcUdpAssociationOwner* aOwner,
+      const std::shared_ptr<NrSocketProxyConfig>& aConfig);
+  void Close();
+
+ private:
+  WebrtcUdpAssociation(WebrtcUdpAssociationOwner* aOwner,
+                       const std::shared_ptr<NrSocketProxyConfig>& aConfig);
+  ~WebrtcUdpAssociation();
+
+  void Lookup();
+  void OnProxy(const nsCString& aType, const nsCString& aHost, int32_t aPort,
+               const nsCString& aUsername, const nsCString& aPassword);
+  void Parse();
+  void Send(const nsTArray<uint8_t>& aBytes);
+  void Fail(const char* aWhy);
+
+  enum class Step { Lookup, Greeting, Auth, Reply, Associated, Done };
+  Step mStep = Step::Lookup;
+  WebrtcUdpAssociationOwner* mOwner;
+  std::shared_ptr<NrSocketProxyConfig> mConfig;
+  nsCString mUsername;
+  nsCString mPassword;
+  nsCOMPtr<nsIEventTarget> mSocketThread;
+  nsCOMPtr<nsISocketTransport> mTransport;
+  nsCOMPtr<nsIAsyncInputStream> mIn;
+  nsCOMPtr<nsIAsyncOutputStream> mOut;
+  nsTArray<uint8_t> mInBuf;
+  nsTArray<uint8_t> mOutBuf;
+};
