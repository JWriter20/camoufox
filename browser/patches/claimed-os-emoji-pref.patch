+// Camoufox: whether the launch identity claims another OS than this build's.
+// The launcher then writes that OS's font.name-list.* defaults (font-prefs.json)
+// as user prefs, since a launcher has no default branch to write to.
+static bool CamouClaimsForeignOS() {
+  const auto os = MaskConfig::GetSpoofedOS();
+#if defined(XP_WIN)
+  return os == MaskConfig::SpoofedOS::MacOS || os == MaskConfig::SpoofedOS::Linux;
+#elif defined(XP_MACOSX)
+  return os == MaskConfig::SpoofedOS::Windows || os == MaskConfig::SpoofedOS::Linux;
+#else
+  return os == MaskConfig::SpoofedOS::Windows || os == MaskConfig::SpoofedOS::MacOS;
+#endif
+}
