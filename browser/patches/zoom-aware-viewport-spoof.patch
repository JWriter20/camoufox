Camoufox: the spoofed viewport and devicePixelRatio follow the page zoom.

window.innerWidth/innerHeight and devicePixelRatio come from the config, as
fixed numbers (fingerprint-injection.patch). Firefox's real ones follow the
page's full zoom (Ctrl+wheel, Ctrl+plus, a site's remembered zoom): at 110% a
device pixel is 55 app units instead of 60, so a 1280x815 viewport is
1173x747 CSS px and devicePixelRatio 1.0909. Measured with camoufox-parity
input.scroll.zoom (2026-10-18): stock zooms to dpr 1.09 and 1173x747,
Camoufox stayed at 1 and 1280x815 -- numbers no zoomed window reports.

The spoofed values are now scaled by the same factor Firefox applies,
AppUnitsPerDevPixelAtUnitFullZoom / AppUnitsPerDevPixel: 1 at 100%, so an
unzoomed page reads the config exactly as before.

--- a/dom/base/nsGlobalWindowInner.cpp
+++ b/dom/base/nsGlobalWindowInner.cpp
@@ -3720,10 +3720,24 @@
   FORWARD_TO_OUTER_OR_THROW(SetNameOuter, (aName, aError), aError, );
 }
 
+// Camoufox: the page's full zoom (Ctrl+wheel, Ctrl+plus), as Firefox applies it
+// -- fewer app units to a device pixel -- so the spoofed devicePixelRatio and
+// viewport follow it the way the real ones do: at 110% a 1280 px viewport is
+// 1173 CSS px and devicePixelRatio 1.0909. Fixed values ignored zoom, and a page
+// that zoomed (or saw the user zoom) read numbers no zoomed window reports.
+static double CamouFullZoomFactor(Document* aDoc) {
+  nsPresContext* presContext = aDoc ? aDoc->GetPresContext() : nullptr;
+  if (!presContext || !presContext->DeviceContext() || !presContext->AppUnitsPerDevPixel()) {
+    return 1.0;
+  }
+  return double(presContext->DeviceContext()->AppUnitsPerDevPixelAtUnitFullZoom()) /
+         presContext->AppUnitsPerDevPixel();
+}
+
 double nsGlobalWindowInner::GetInnerWidth(CallerType aCallerType,
                                           ErrorResult& aError) {
   if (auto value = MaskConfig::GetDouble("window.innerWidth"))
-    return value.value();
+    return std::round(value.value() / CamouFullZoomFactor(mDoc));
   FORWARD_TO_OUTER_OR_THROW(GetInnerWidthOuter, (aCallerType, aError), aError,
                             0);
 }
@@ -3738,7 +3752,7 @@
 double nsGlobalWindowInner::GetInnerHeight(CallerType aCallerType,
                                            ErrorResult& aError) {
   if (auto value = MaskConfig::GetDouble("window.innerHeight"))
-    return value.value();
+    return std::round(value.value() / CamouFullZoomFactor(mDoc));
   FORWARD_TO_OUTER_OR_THROW(GetInnerHeightOuter, (aCallerType, aError), aError,
                             0);
 }
@@ -3819,7 +3833,7 @@
                                                 ErrorResult& aError) {
   ENSURE_ACTIVE_DOCUMENT(aError, 0.0);
   if (auto value = MaskConfig::GetDouble("window.devicePixelRatio"))
-    return value.value();
+    return value.value() * CamouFullZoomFactor(mDoc);
 
   RefPtr<nsPresContext> presContext = GetPresContextForRatio(mDoc);
   if (NS_WARN_IF(!presContext)) {
