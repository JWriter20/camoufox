+// Legacy names stock win-i9 never resolves before the aliases load, even as
+// the first name asked for (2026-10-31): Rockwell Extra Bold's stripped base
+// "rockwell extra" is no family, and Rockwell Condensed's base read does not
+// list it (inferred: a nameID 1 family of its own, without nameID 16). Whether
+// such a lookup starts the loader was not measured; it is taken not to.
+static constexpr std::string_view kWindowsLegacyMissingNames[] = {
+    "rockwell condensed",
+    "rockwell extra bold",
+};
+
+// The base of a legacy name: what Gecko strips it to (up to the last space).
+static std::string_view WindowsLegacyBase(std::string_view aName) {
+  size_t space = aName.rfind(' ');
+  return space == std::string_view::npos ? aName : aName.substr(0, space);
+}
+
+// Per content process, as stock's mAliasTable is: which bases have had their
+// face names read (one flag per table entry, set for every entry sharing the
+// base), and when the deferred loader's aliases are in place.
+static bool sWindowsLegacyBaseRead[std::size(kWindowsLegacyFamilyNames)];
+static mozilla::TimeStamp sWindowsLegacyAliasesAt;
+
+enum class WindowsLegacyLookup { NotLegacy, UseBase, Missing };
+
+// When the loader's aliases land, stock reflows: the parent's
+// gfxPlatformFontList::CancelInitOtherFamilyNamesTask calls ForceGlobalReflow
+// (FontsChanged, to every content process), whose "font-info-updated" makes
+// each pres context flush its font cache (nsPresContext::
+// ForceReflowForFontInfoUpdate), so text and canvas fonts that took a legacy
+// name's early answer resolve it again, to the real face. Without that, the
+// early answer stayed in the font cache for good: the same font measured
+// Times New Roman long after the aliases had landed, a font never asked for
+// before measured the Black face. A process that gave an early answer does
+// the same at the moment the aliases land. Guarded by the font list's lock.
+static mozilla::TimeStamp sWindowsLegacyReflowAt;
+// Only the latest schedule reflows (an earlier landing replaces a later one).
+static std::atomic<uint32_t> sWindowsLegacyReflowSchedule{0};
+
+static void WindowsLegacyAliasReflowAt(mozilla::TimeStamp aAt,
+                                       uint32_t aSchedule) {
+  if (aSchedule != sWindowsLegacyReflowSchedule) {
+    return;
+  }
+  const mozilla::TimeDuration wait = aAt - mozilla::TimeStamp::Now();
+  if (wait > mozilla::TimeDuration()) {
+    // A timer may fire a little early; the aliases must have landed by then.
+    NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction(
+            "WindowsLegacyAliasReflow",
+            [aAt, aSchedule] { WindowsLegacyAliasReflowAt(aAt, aSchedule); }),
+        uint32_t(wait.ToMilliseconds()) + 1);
+    return;
+  }
+  gfxPlatform::ForceGlobalReflow(gfxPlatform::GlobalReflowFlags::FontsChanged);
+}
+
+static void ScheduleWindowsLegacyAliasReflow(mozilla::TimeStamp aAt) {
+  if (!sWindowsLegacyReflowAt.IsNull() && sWindowsLegacyReflowAt <= aAt) {
+    return;
+  }
+  sWindowsLegacyReflowAt = aAt;
+  const uint32_t schedule = ++sWindowsLegacyReflowSchedule;
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "WindowsLegacyAliasReflow",
+      [aAt, schedule] { WindowsLegacyAliasReflowAt(aAt, schedule); }));
+}
+
+// Called with the platform font list's lock held.
+static WindowsLegacyLookup ClassifyWindowsLegacyName(
+    const nsACString& aLowercaseName) {
+  std::string_view name(aLowercaseName.BeginReading(),
+                        aLowercaseName.Length());
+  const auto* begin = std::begin(kWindowsLegacyFamilyNames);
+  const auto* end = std::end(kWindowsLegacyFamilyNames);
+  const auto* it = std::lower_bound(begin, end, name);
+  const bool alwaysMissing =
+      std::binary_search(std::begin(kWindowsLegacyMissingNames),
+                         std::end(kWindowsLegacyMissingNames), name);
+  if (!alwaysMissing && (it == end || *it != name)) {
+    return WindowsLegacyLookup::NotLegacy;
+  }
+
+  // The loader's run: how long reading every family's names takes once it
+  // starts. Windows starts it 60 s after the font list is built (the content
+  // process's creation stands in for that), or at the first legacy lookup.
+  // Stock win-i9 landed them 1727-1832 ms after the first lookup (100 ms
+  // poll); the launcher draws a value per launch.
+  const auto loadMs =
+      MaskConfig::GetUint32("fonts:windowsAliasLoadMs").value_or(1780);
+  const auto now = mozilla::TimeStamp::Now();
+  const auto natural =
+      mozilla::TimeStamp::ProcessCreation() +
+      mozilla::TimeDuration::FromMilliseconds(60000 + loadMs);
+  if (now >= natural ||
+      (!sWindowsLegacyAliasesAt.IsNull() && now >= sWindowsLegacyAliasesAt)) {
+    // The aliases are loaded: the name is a family of its legacy faces, which
+    // is what fontconfig's family of that name already is.
+    return WindowsLegacyLookup::NotLegacy;
+  }
+
+  // An early answer holds until the aliases land: at the end of the loader
+  // a legacy lookup started, else of the one started 60 s in.
+  const auto landing = [&] {
+    ScheduleWindowsLegacyAliasReflow(
+        sWindowsLegacyAliasesAt.IsNull() || natural < sWindowsLegacyAliasesAt
+            ? natural
+            : sWindowsLegacyAliasesAt);
+  };
+  if (alwaysMissing) {
+    landing();
+    return WindowsLegacyLookup::Missing;
+  }
+  const size_t index = it - begin;
+  if (sWindowsLegacyBaseRead[index]) {
+    landing();
+    return WindowsLegacyLookup::Missing;
+  }
+  const std::string_view base = WindowsLegacyBase(name);
+  for (size_t i = 0; i < std::size(kWindowsLegacyFamilyNames); i++) {
+    if (WindowsLegacyBase(kWindowsLegacyFamilyNames[i]) == base) {
+      sWindowsLegacyBaseRead[i] = true;
+    }
+  }
+  if (sWindowsLegacyAliasesAt.IsNull()) {
+    // The alias family has fewer faces than its base, so stock kicks off the
+    // loader now (SharedFontList.cpp:1305-1312).
+    sWindowsLegacyAliasesAt =
+        now + mozilla::TimeDuration::FromMilliseconds(loadMs);
+  }
+  landing();
+  return WindowsLegacyLookup::UseBase;
+}
