diff --git a/dom/geolocation/GeolocationSystem.cpp b/dom/geolocation/GeolocationSystem.cpp
index 82c2951b4d..f51c60a03c 100644
--- a/dom/geolocation/GeolocationSystem.cpp
+++ b/dom/geolocation/GeolocationSystem.cpp
@@ -3,20 +3,73 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
 
 #include "GeolocationSystem.h"
+#include "MaskConfig.hpp"
 
 namespace mozilla::dom::geolocation {
 
+// Camoufox: the identity's OS location setting (geolocation:systemPermission).
+// Windows answers "prompt" when apps must still be allowed and a Wi-Fi adapter
+// can raise the OS prompt (SystemWillPromptUser), "denied" when location is off
+// for apps (GeckoWillPromptUser); either way the page's permission reads
+// "prompt" and a position request waits on a tab-modal dialog
+// (GeolocationSystemWin.cpp). Unset, or "allowed", is this platform's NoPrompt.
 SystemGeolocationPermissionBehavior GetGeolocationPermissionBehavior() {
+  if (auto state = MaskConfig::GetString("geolocation:systemPermission")) {
+    if (*state == "prompt") {
+      return SystemGeolocationPermissionBehavior::SystemWillPromptUser;
+    }
+    if (*state == "denied") {
+      return SystemGeolocationPermissionBehavior::GeckoWillPromptUser;
+    }
+  }
   return SystemGeolocationPermissionBehavior::NoPrompt;
 }
 
+namespace {
+
+// The identity's OS never changes its setting, so the request waits until the
+// dialog that shows it closes (CancelSystemGeolocationPermissionRequest), and
+// then reports what Windows does when access is still not permitted.
+class SpoofedGeolocationPermissionRequest final
+    : public SystemGeolocationPermissionRequest {
+ public:
+  NS_INLINE_DECL_REFCOUNTING(SpoofedGeolocationPermissionRequest, override);
+
+  explicit SpoofedGeolocationPermissionRequest(
+      ParentRequestResolver&& aResolver)
+      : mResolver(std::move(aResolver)) {}
+
+  void Stop() override {
+    MOZ_ASSERT(NS_IsMainThread());
+    if (!mIsRunning) {
+      return;
+    }
+    mIsRunning = false;
+    mResolver(GeolocationPermissionStatus::Canceled);
+  }
+
+ private:
+  ~SpoofedGeolocationPermissionRequest() { Stop(); }
+
+  ParentRequestResolver mResolver;
+  bool mIsRunning = true;
+};
+
+}  // namespace
+
 already_AddRefed<SystemGeolocationPermissionRequest>
 RequestLocationPermissionFromUser(BrowsingContext* aBrowsingContext,
                                   ParentRequestResolver&& aResolver) {
-  MOZ_ASSERT_UNREACHABLE(
-      "Should not warn user of need for system location permission "
-      "since we cannot open system settings on this platform.");
-  return nullptr;
+  if (GetGeolocationPermissionBehavior() ==
+      SystemGeolocationPermissionBehavior::NoPrompt) {
+    MOZ_ASSERT_UNREACHABLE(
+        "Should not warn user of need for system location permission "
+        "since we cannot open system settings on this platform.");
+    aResolver(GeolocationPermissionStatus::Error);
+    return nullptr;
+  }
+  return MakeAndAddRef<SpoofedGeolocationPermissionRequest>(
+      std::move(aResolver));
 }
 
 }  // namespace mozilla::dom::geolocation
