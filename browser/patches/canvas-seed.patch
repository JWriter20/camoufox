@@ -1320,6 +1322,41 @@ bool nsRFPService::GetSpoofedKeyCode(const dom::Document* aDoc,
 // ============================================================================
 // ============================================================================
 // Randomization Stuff
+
+// Firefox seeds the canvas randomization with a UUID minted once per browser
+// session, so the canvas fingerprint changes on every launch even when the
+// profile is reused. Deriving the same key from `canvas:seed` instead keeps the
+// fingerprint stable for as long as the caller passes the same seed, while
+// leaving the per-site HMAC in GenerateKey() untouched.
+static uint64_t CamouSplitMix64(uint64_t& aState) {
+  aState += 0x9E3779B97F4A7C15ull;
+  uint64_t z = aState;
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+  return z ^ (z >> 31);
+}
+
+// The origin attribute suffix carries the userContextId, so separate browser
+// contexts still get separate canvas keys -- just deterministic ones.
+static nsID CamouDeriveBrowsingSessionKey(uint32_t aSeed,
+                                          const nsACString& aOASuffix) {
+  uint64_t state = (static_cast<uint64_t>(aSeed) << 32) ^
+                   static_cast<uint64_t>(HashString(
+                       PromiseFlatCString(aOASuffix).get(), aOASuffix.Length()));
+
+  uint64_t lo = CamouSplitMix64(state);
+  uint64_t hi = CamouSplitMix64(state);
+
+  nsID id{};
+  id.m0 = static_cast<uint32_t>(lo >> 32);
+  id.m1 = static_cast<uint16_t>(lo >> 16);
+  id.m2 = static_cast<uint16_t>(lo);
+  for (size_t i = 0; i < sizeof(id.m3); ++i) {
+    id.m3[i] = static_cast<uint8_t>(hi >> (8 * i));
+  }
+  return id;
+}
+
 nsresult nsRFPService::GetBrowsingSessionKey(
     const OriginAttributes& aOriginAttributes, nsID& aBrowsingSessionKey) {
   MOZ_ASSERT(XRE_IsParentProcess());
@@ -1346,6 +1383,15 @@ nsresult nsRFPService::GetBrowsingSessionKey(
