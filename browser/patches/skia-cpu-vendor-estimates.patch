+/*
+ * Camoufox: x86 RCPPS / RSQRTPS estimates of a CPU vendor other than the host's.
+ *
+ * Skia's raster pipeline takes reciprocals and reciprocal square roots from the
+ * hardware estimate (SkRasterPipeline_opts.h rcp_approx / rsqrt_approx:
+ * _mm256_rcp_ps, _mm_rcp_ps, _mm256_rsqrt_ps, _mm_rsqrt_ps). Only the 12-bit
+ * accuracy is architectural; the bits differ between vendors, and they reach a
+ * page's pixels through every blend that divides (color-burn, color-dodge,
+ * hue/saturation/color/luminosity) and through perspective. A Windows identity
+ * that claims an Intel machine, drawn on an AMD host, would show AMD's bits.
+ *
+ * Both vendors' estimates are a table lookup on the top 12 mantissa bits with a
+ * 12-bit result (Intel's RCPPS: 1/(1 + (top11 + 0.5)/2^11) rounded to nearest at 12
+ * bits), scaled by the exponent, with these edges: +-0 and denormals give +-inf,
+ * +-inf gives +-0 (rsqrt: -inf gives NaN), NaN is quieted, negative rsqrt gives the
+ * default NaN, and a reciprocal below the normal range flushes to +-0. Verified
+ * bit-exact for every one of the 2^32 inputs on AMD Ryzen 7 9850X3D (all four
+ * instructions) and for [1,2) on Intel i9-11900H (RCPPS binade checksum
+ * e46220483be10383).
+ *
+ * gVendor is set once per process (SkOpts::Init, from the identity's cpu:vendor
+ * when it names a vendor other than the host's); 0 keeps the hardware estimate.
+ */
+#ifndef SkCamouApprox_DEFINED
+#define SkCamouApprox_DEFINED
+
+#include <cstdint>
+
+namespace SkCamouApprox {
+
+enum Vendor : int { kNative = 0, kIntel = 1, kAmd = 2 };
+
+inline int gVendor = kNative;
+
+// Sets gVendor from the identity (SkOpts.cpp).
+void Init();
