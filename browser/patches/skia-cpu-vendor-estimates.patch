+static inline const uint16_t* RcpTable() {
+    return gVendor == kIntel ? kIntelRcp : gVendor == kAmd ? kAmdRcp : nullptr;
+}
+
+static inline const uint16_t* RsqrtTable() {
+    return gVendor == kAmd ? kAmdRsqrt : gVendor == kIntel ? kIntelRsqrt : nullptr;
+}
+
+static inline uint32_t Rcp(uint32_t x, const uint16_t* t) {
+    uint32_t s = x & 0x80000000u, e = (x >> 23) & 0xff, m = x & 0x7fffff;
+    if (e == 0) return s | 0x7f800000u;
+    if (e == 255) return m ? (x | 0x400000u) : s;
+    int r = 253 - (int)e;
+    if (r <= 0) return s;
+    return s | ((uint32_t)r << 23) | ((uint32_t)t[m >> 11] << 11);
+}
+
+static inline uint32_t Rsqrt(uint32_t x, const uint16_t* t) {
+    uint32_t s = x & 0x80000000u, e = (x >> 23) & 0xff, m = x & 0x7fffff;
+    if (e == 0) return s | 0x7f800000u;
+    if (e == 255) return m ? (x | 0x400000u) : (s ? 0xffc00000u : 0);
+    if (s) return 0xffc00000u;
+    int p = (int)e - 127, odd = p & 1;
+    int r = 126 - ((p - odd) >> 1);
+    return ((uint32_t)r << 23) | ((uint32_t)t[(odd << 12) | (m >> 11)] << 11);
+}
