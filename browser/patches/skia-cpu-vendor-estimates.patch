+namespace SkCamouApprox {
+#if defined(SK_CPU_X86)
+    static int HostVendor() {
+        unsigned r[4] = {0, 0, 0, 0};
+    #if defined(_MSC_VER) && !defined(__clang__)
+        int x[4];
+        __cpuid(x, 0);
+        memcpy(r, x, sizeof(r));
+    #else
+        __get_cpuid(0, &r[0], &r[1], &r[2], &r[3]);
+    #endif
+        char id[13] = {0};
+        memcpy(id, &r[1], 4);
+        memcpy(id + 4, &r[3], 4);
+        memcpy(id + 8, &r[2], 4);
+        return !strcmp(id, "GenuineIntel") ? kIntel : !strcmp(id, "AuthenticAMD") ? kAmd : kNative;
+    }
+#endif
+
+    // The identity's CPU vendor (cpu:vendor, "intel" or "amd"), when it is not
+    // the host's: Skia's reciprocal estimates then give that vendor's bits.
+    // CAMOU_CONFIG is fixed for the process, so this runs once, from Init().
+    void Init() {
+    #if defined(SK_CPU_X86)
+        static const int sVendor = [] {
+            std::string claimed = MaskConfig::GetString("cpu:vendor").value_or("");
+            int want = claimed == "intel" ? kIntel : claimed == "amd" ? kAmd : kNative;
+            return want != kNative && want != HostVendor() ? want : int(kNative);
+        }();
+        gVendor = sVendor;
+    #endif
+    }
+}  // namespace SkCamouApprox
