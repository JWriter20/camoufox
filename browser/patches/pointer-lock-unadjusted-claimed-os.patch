+// Camoufox: whether a page in `aDocument` may lock the pointer with
+// unadjusted movement. Stock Windows Firefox supports it (raw input), stock
+// Linux does not; the support check runs before the user-activation check, so
+// without this a Windows identity's request without a gesture rejects with
+// NotSupportedError where stock Windows says NotAllowedError. On a widget that
+// cannot do it, the lock is a regular one: SetNativePointerLockMode and
+// LockNativePointer(Unadjusted) are no-ops there.
+static bool SupportsUnadjustedMovement(nsIWidget* aWidget,
+                                       Document* aDocument) {
+  return aWidget->SupportsUnadjustedMovement() ||
+         NavigatorManager::GetSpoofedOS(
+             RoverfoxStorageManager::UserContextId(aDocument)) ==
+             MaskConfig::SpoofedOS::Windows;
+}
+
 NS_IMETHODIMP
 PointerLockManager::PointerLockRequest::Run() {
   nsCOMPtr<Element> element = do_QueryReferent(mElement);
@@ -593,7 +611,7 @@
     error = "PointerLockDeniedMovedDocument";
   } else if (mUnadjustedMovement) {
