diff --git a/dom/xul/XULMenuParentElement.cpp b/dom/xul/XULMenuParentElement.cpp
--- a/dom/xul/XULMenuParentElement.cpp
+++ b/dom/xul/XULMenuParentElement.cpp
@@ -20,9 +20,24 @@
 #include "nsStringFwd.h"
 #include "nsXULElement.h"
 #include "nsXULPopupManager.h"
+#include "MaskConfig.hpp"
 
 namespace mozilla::dom {
 
+// Camoufox: whether keyboard navigation in an open menulist (a <select>'s
+// dropdown) selects the item at once, as Windows Firefox does (see
+// SetActiveMenuChild). Elsewhere the item only becomes the value with Enter,
+// so Escape after an arrow key put the old value back; stock Firefox 158.0.1
+// on win-i9 (cfparity input.forms.select) kept the new one and fired input
+// and change. A Windows identity on another host behaves as Windows does.
+static bool MenuListSelectsByKeyboard() {
+#ifdef XP_WIN
+  return true;
+#else
+  return MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows;
+#endif
+}
+
 NS_IMPL_ISUPPORTS_CYCLE_COLLECTION_INHERITED_0(XULMenuParentElement,
                                                nsXULElement)
 NS_IMPL_CYCLE_COLLECTION_INHERITED(XULMenuParentElement, nsXULElement,
@@ -152,13 +167,12 @@ void XULMenuParentElement::SetActiveMenu
   if (IsInMenuList()) {
     if (nsMenuPopupFrame* f = do_QueryFrame(GetPrimaryFrame())) {
       f->EnsureActiveMenuListItemIsVisible();
-#ifdef XP_WIN
       // On Windows, a menulist should update its value whenever navigation was
       // done by the keyboard.
       //
       // NOTE(emilio): This is a rather odd per-platform behavior difference,
       // but other browsers also do this.
-      if (aByKey == ByKey::Yes && f->IsOpen()) {
+      if (aByKey == ByKey::Yes && f->IsOpen() && MenuListSelectsByKeyboard()) {
         // Fire a command event as the new item, but we don't want to close the
         // menu, blink it, or update any other state of the menuitem. The
         // command event will cause the item to be selected.
@@ -167,7 +181,6 @@ void XULMenuParentElement::SetActiveMenu
                                            nullptr, presShell, false, false,
                                            false, false);
       }
-#endif
     }
   }
 }
