+// The identity's voices, registered as the OS backend it claims would register
+// them. A spoofed voice has no service (SpeakImpl speaks it silently).
+void nsSynthVoiceRegistry::AddSpoofedVoices() {
+  if (auto speechd = MaskConfig::MSpeechdVoices()) {
+    // SpeechDispatcherService::Setup builds this table in speech-dispatcher's
+    // order and RegisterVoices adds the voices in the table's iteration order,
+    // which is the order getVoices() reports. Same table, same insertions,
+    // same order.
+    nsRefPtrHashtable<nsStringHashKey, SpoofedSpeechdVoice> table;
+    for (const auto& [name, lang] : speechd.value()) {
+      nsAutoString uri;
+      uri.AssignLiteral("urn:moz-tts:speechd:");
+      nsAutoCString escaped;
+      NS_EscapeURL(name.c_str(), -1,
+                   esc_OnlyNonASCII | esc_Spaces | esc_AlwaysCopy, escaped);
+      uri.Append(NS_ConvertUTF8toUTF16(escaped));
+      uri.AppendLiteral("?");
+      uri.Append(NS_ConvertUTF8toUTF16(lang));
+      table.InsertOrUpdate(uri, MakeRefPtr<SpoofedSpeechdVoice>(
+                                    NS_ConvertUTF8toUTF16(name),
+                                    NS_ConvertUTF8toUTF16(lang)));
+    }
+    for (const auto& entry : table) {
+      const RefPtr<SpoofedSpeechdVoice>& voice = entry.GetData();
+      // As RegisterVoices does: local only for a voice named "default".
+      AddVoiceImpl(nullptr, entry.GetKey(), voice->mName, voice->mLanguage,
+                   voice->mName.EqualsLiteral("default"), true);
+    }
+    return;
+  }
+  if (auto voices = MaskConfig::MVoices()) {
+    for (const auto& [lang, name, uri, isDefault, isLocal] : voices.value()) {
+      const NS_ConvertUTF8toUTF16 voiceUri(uri);
+      // SAPI voices queue their utterances and macOS's do not, as each
+      // backend registers them.
+      const bool queues =
+          StringBeginsWith(voiceUri, u"urn:moz-tts:sapi:"_ns);
+      AddVoiceImpl(nullptr, voiceUri, NS_ConvertUTF8toUTF16(name),
+                   NS_ConvertUTF8toUTF16(lang), isLocal, queues);
+      if (isDefault) {
+        SetDefaultVoice(voiceUri, true);
+      }
+    }
+  }
+}
