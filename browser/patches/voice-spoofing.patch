+namespace {
+
+// Camoufox: a Windows identity's spoofed voice speaks as SAPI does
+// (windows/SapiService.cpp), as stock Firefox 158 on win-i9 reports it
+// (Microsoft David, Mark, Zira and the Desktop voices, 10 launches):
+//  - start ~0.1 s after speak(), with elapsedTime 0; every later
+//    elapsedTime counts from speak();
+//  - per sentence a "sentence" boundary at its first word, charLength
+//    through its closing . ! or ? (else the last non-space character);
+//  - per word a "word" boundary, charLength without trailing punctuation
+//    ("world." 5, "stop-now," 8); a decimal number is spoken word by word,
+//    one boundary each at the same index ("3.14": four);
+//  - end at the text's length, about 0.9 s after the last word starts at
+//    rate 1; empty text: start, then end at once.
+// Timing: ~58 ms a character at rate 1, a sentence break ~0.9 s and a comma
+// ~0.3 s more, all divided by SAPI's speed 3^(n/10), n = trunc(10 log3 rate)
+// clipped to +-10.
+double SapiJitter(double aSpan) {
+  return aSpan * static_cast<double>(RandomUint64OrDie() >> 11) /
+         9007199254740992.0;
+}
+
+void SpeakLikeSapi(nsSpeechTask* aTask, const nsAString& aText, float aRate) {
+  RefPtr<nsSpeechTask> task = aTask;
+  const TimeStamp origin = TimeStamp::Now();
+  const auto since = [origin]() {
+    return static_cast<float>((TimeStamp::Now() - origin).ToSeconds());
+  };
+  const auto at = [](double aSeconds, auto&& aFn, const char* aName) {
+    NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction(aName, std::forward<decltype(aFn)>(aFn)),
+        static_cast<uint32_t>(std::max(0.0, aSeconds) * 1000));
+  };
+  const double steps =
+      aRate > 0 ? std::trunc(10 * std::log10(aRate) / std::log10(3.0)) : 0;
+  const double speed = std::pow(3.0, std::clamp(steps, -10.0, 10.0) / 10.0);
+  const double perChar = 0.058 / speed;
+  const double startAt = 0.10 + SapiJitter(0.04);
+  at(startAt, [task]() { (void)task->DispatchStart(); }, "CamouSapiStart");
+
+  const uint32_t length = aText.Length();
+  const auto isSpace = [&](uint32_t i) {
+    return nsContentUtils::IsHTMLWhitespace(aText[i]);
+  };
+  const auto ends = [](char16_t c) { return c == '.' || c == '!' || c == '?'; };
+  const auto trails = [&](char16_t c) {
+    return ends(c) || c == ',' || c == ';' || c == ':' || c == '"' ||
+           c == ')' || c == ']';
+  };
+  double word = startAt + std::max(0.12 / speed, 0.075);
+  bool newSentence = true;
+  double lastWord = -1;
+  uint32_t lastLength = 0;
+  uint32_t i = 0;
+  while (i < length) {
+    while (i < length && isSpace(i)) ++i;
+    if (i >= length) break;
+    const uint32_t start = i;
+    while (i < length && !isSpace(i)) ++i;
+    const uint32_t tokenEnd = i;
+    uint32_t wordEnd = tokenEnd;
+    while (wordEnd > start && trails(aText[wordEnd - 1])) --wordEnd;
+    bool spoken = false;
+    bool decimal = false;
+    uint32_t fraction = 0;
+    for (uint32_t k = start; k < wordEnd; ++k) {
+      spoken |= nsContentUtils::IsAlphanumeric(aText[k]);
+      if (aText[k] == '.' && k > start && k + 1 < wordEnd &&
+          aText[k - 1] >= '0' && aText[k - 1] <= '9') {
+        decimal = true;
+        fraction = 0;
+      } else if (decimal && aText[k] >= '0' && aText[k] <= '9') {
+        ++fraction;
+      }
+    }
+    if (!spoken) continue;
+    if (newSentence) {
+      uint32_t sentenceEnd = start;
+      for (uint32_t k = start; k < length; ++k) {
+        if (!isSpace(k)) sentenceEnd = k + 1;
+        if (ends(aText[k]) && (k + 1 == length || isSpace(k + 1))) break;
+      }
+      at(std::max(startAt, word - 0.1 / speed),
+         [task, since, start, len = sentenceEnd - start]() {
+           (void)task->DispatchBoundary(u"sentence"_ns, since(), start, len, 1);
+         },
+         "CamouSapiSentence");
+      newSentence = false;
+    }
+    const uint32_t spokenWords = decimal ? 2 + fraction : 1;
+    for (uint32_t n = 0; n < spokenWords; ++n) {
+      const double t = word + n * 0.27 / speed + SapiJitter(0.01);
+      at(t,
+         [task, since, start, len = wordEnd - start]() {
+           (void)task->DispatchBoundary(u"word"_ns, since(), start, len, 1);
+         },
+         "CamouSapiWord");
+      lastWord = t;
+    }
+    lastLength = wordEnd - start;
+    word += (spokenWords - 1) * 0.27 / speed + perChar * (tokenEnd - start + 1);
+    const char16_t last = aText[tokenEnd - 1];
+    if (ends(last)) {
+      word += 0.9 / speed;
+      newSentence = true;
+    } else if (last == ',' || last == ';' || last == ':') {
+      word += 0.3 / speed;
+    }
+  }
+  const double endAt =
+      lastWord < 0 ? startAt
+                   : lastWord + perChar * lastLength +
+                         std::max(0.9 / speed, 0.45) + SapiJitter(0.03);
+  at(endAt, [task, since, length]() { (void)task->DispatchEnd(since(), length); },
+     "CamouSapiEnd");
+}
