+// Camoufox: a Windows identity's drop-down behaves as Windows Firefox's: a click
+// outside the open list closes it and still reaches the page (stock Firefox
+// 158.0.1 on win-i9: the outside click's mousedown/mouseup hit the page; on
+// Linux the list consumes it), and keys other than shortcuts go to the list.
+function claimsWindows() {
+  try {
+    return (ChromeUtils.camouGetString("navigator.platform") || "").startsWith(
+      "Win"
+    );
+  } catch (e) {
+    return false;
+  }
+}
+const DROPDOWN_AS_WINDOWS = AppConstants.platform == "win" || claimsWindows();
