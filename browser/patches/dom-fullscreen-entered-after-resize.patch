+  /**
+   * Camoufox: FullScreen.enterDomFullscreen tells the content process to
+   * enter fullscreen (DOMFullscreen:Entered) before it gives the chrome its
+   * fullscreen layout, and the remote browser's new size would only go out
+   * with the chrome's next paint, so the page could fire fullscreenchange
+   * while still laid out at its old size (or with the toolbox showing). The
+   * message is held until that call returns and goes right after the remote
+   * browser's size. Done here, not in browser-fullScreenAndPointerLock.js:
+   * pages can load that script, so a byte changed there is visible to them.
+   */
+  enterDomFullscreen(aWindow, aBrowser) {
+    gHeldEntered = [];
+    try {
+      aWindow.FullScreen.enterDomFullscreen(aBrowser, this);
+    } finally {
+      const held = gHeldEntered;
+      gHeldEntered = null;
+      if (held.length) {
+        aWindow.document.synchronouslyUpdateRemoteBrowserDimensions();
+        held.forEach(send => send());
+      }
+    }
+  }
