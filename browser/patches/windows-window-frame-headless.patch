 #include "HeadlessKeyBindings.h"
@@ -232,7 +233,32 @@
   if (mWindowType == WindowType::Popup) {
     return mBounds.TopLeft();
   }
-  return GetTopLevelWidget()->GetBounds().TopLeft();
+  return GetTopLevelWidget()->GetClientBounds().TopLeft();
+}
+
+// Camoufox: with no frame, a headless window's client area was its window
+// rect, so a page read outerWidth == innerWidth and mozInnerScreenX ==
+// screenX where the same identity in a real window reads the frame between
+// them. Only a Windows identity claims a frame, as in the GTK widget.
+LayoutDeviceIntMargin HeadlessWidget::ClientMargin(nsSizeMode aMode) const {
+  if ((mWindowType != WindowType::TopLevel &&
+       mWindowType != WindowType::Dialog) ||
+      !ClaimsWindowsFrame()) {
+    return {};
+  }
+  return ClaimedWindowsFrame<LayoutDeviceIntMargin>(
+      aMode, WindowHasToolbar(mWidgetListener), 1.0);
+}
+
+LayoutDeviceIntRect HeadlessWidget::GetClientBounds() {
+  LayoutDeviceIntRect client = mBounds;
+  client.Deflate(ClientMargin(mSizeMode));
+  return client;
+}
+
+LayoutDeviceIntPoint HeadlessWidget::GetClientOffset() {
+  const LayoutDeviceIntMargin margin = ClientMargin(mSizeMode);
+  return {margin.left, margin.top};
 }
 
