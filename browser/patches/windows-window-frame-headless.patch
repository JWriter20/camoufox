--- /dev/null
+++ b/widget/ClaimedWindowFrame.h
@@ -0,0 +1,121 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Camoufox: the frame a Windows identity's window has, for the widgets that
+// stand in for a Windows one (GTK, and headless, which has no frame at all).
+// Windows Firefox draws its tabs in the titlebar, so a normal window's client
+// area runs to the top edge, and the window rect carries the invisible resize
+// border on the other three sides; a maximized window overhangs the work area
+// by that border on all four; fullscreen has none.
+
+#ifndef mozilla_widget_ClaimedWindowFrame_h
+#define mozilla_widget_ClaimedWindowFrame_h
+
+#include <cmath>
+#include <iterator>
+
+#include "MaskConfig.hpp"
+#include "nsIAppWindow.h"
+#include "nsIWebBrowserChrome.h"
+#include "nsIWidgetListener.h"
+
+namespace mozilla::widget {
+
+inline bool ClaimsWindowsFrame() {
+  return MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows &&
+         MaskConfig::HostOS() != MaskConfig::SpoofedOS::Windows;
+}
+
+// The identity's devicePixelRatio is the DPI Windows scales its frame to.
+inline double ClaimedWindowsDpr() {
+  return MaskConfig::GetDouble("window.devicePixelRatio").value_or(1.0);
+}
+
+// The border is SM_CXFRAME + SM_CXPADDEDBORDER at the display's DPI, in device
+// pixels. Measured with stock Firefox: 8 at 96 DPI (dpr 1) and 16 at 240 DPI
+// (dpr 2.5, outerWidth - innerWidth = 12.8). Between those it follows 3 +
+// round(dpr) + round(4 * dpr), which reproduces both and the recorded
+// population's 7 CSS px at dpr 1.25, 1.5 and 2.
+inline int32_t WindowsResizeBorderDevicePixels(double aDpr) {
+  auto roundHalfUp = [](double v) { return int32_t(std::floor(v + 0.5)); };
+  return 3 + roundHalfUp(aDpr) + roundHalfUp(4 * aDpr);
+}
+
+// A window that does not draw in its titlebar (a pop-up) has Windows's
+// caption above the client area: SM_CYCAPTION,
+// the NONCLIENTMETRICS caption height (22 at 96 DPI) scaled to the DPI plus
+// one, so the client area starts this far below the resize border. With the
+// border, it reproduces within a device pixel what stock Firefox 158 on
+// Windows put above a window.open pop-up's toolbar at 100, 125, 150, 175, 200,
+// 225 and 250 % (31, 38, 45, 52, 58, 64 and 72 device px).
+inline int32_t WindowsCaptionDevicePixels(double aDpr) {
+  return int32_t(std::floor(22 * aDpr + 0.5)) + 1;
+}
+
+// Windows keeps a window at least SM_CXMINTRACK wide: the caption's buttons,
+// icon and borders. Stock Firefox 158 on Windows, a window.open pop-up asked
+// for 100 CSS px: 136, 166, 198, 231, 258, 291 and 325 device px wide at 100,
+// 125, 150, 175, 200, 225 and 250 %. It does not follow one rounding of the
+// DPI, so it is the measured values, linear between them.
+inline int32_t WindowsMinTrackWidthDevicePixels(double aDpr) {
+  static constexpr double kDpr[] = {1, 1.25, 1.5, 1.75, 2, 2.25, 2.5};
+  static constexpr double kWidth[] = {136, 166, 198, 231, 258, 291, 325};
+  constexpr size_t kLast = std::size(kDpr) - 1;
+  if (aDpr <= kDpr[0]) {
+    return int32_t(std::round(kWidth[0] * aDpr / kDpr[0]));
+  }
+  if (aDpr >= kDpr[kLast]) {
+    return int32_t(std::round(kWidth[kLast] * aDpr / kDpr[kLast]));
+  }
+  size_t i = 1;
+  while (kDpr[i] < aDpr) {
+    i++;
+  }
+  const double t = (aDpr - kDpr[i - 1]) / (kDpr[i] - kDpr[i - 1]);
+  return int32_t(std::round(kWidth[i - 1] + t * (kWidth[i] - kWidth[i - 1])));
+}
+
+// Whether the window was opened with a toolbar. Windows Firefox draws the
+// tabs of every such window in its titlebar, and not those of a pop-up opened
+// without one (TabBarVisibility: CustomTitlebar.allowedBy("non-popup")), which
+// keeps the system caption.
+inline bool WindowHasToolbar(nsIWidgetListener* aListener) {
+  nsIAppWindow* appWindow = aListener ? aListener->GetAppWindow() : nullptr;
+  uint32_t flags = 0;
+  return appWindow && NS_SUCCEEDED(appWindow->GetChromeFlags(&flags)) &&
+         (flags & nsIWebBrowserChrome::CHROME_TOOLBAR);
+}
+
+// The frame around the client area of a top-level window in aSizeMode, in the
+// widget's own units: aDevicePixelsPerUnit device pixels each.
+template <typename Margin>
+Margin ClaimedWindowsFrame(nsSizeMode aSizeMode, bool aCustomTitlebar,
+                           double aDevicePixelsPerUnit) {
+  if (aSizeMode == nsSizeMode_Fullscreen) {
+    return {};
+  }
+  const double dpr = ClaimedWindowsDpr();
+  const int32_t border = int32_t(
+      std::round(WindowsResizeBorderDevicePixels(dpr) / aDevicePixelsPerUnit));
+  if (aSizeMode == nsSizeMode_Maximized) {
+    return Margin(border, border, border, border);
+  }
+  if (!aCustomTitlebar) {
+    const int32_t caption = int32_t(
+        std::round(WindowsCaptionDevicePixels(dpr) / aDevicePixelsPerUnit));
+    return Margin(border + caption, border, border, border);
+  }
+  return Margin(0, border, border, border);
+}
+
+// The least width of a normal top-level window, in the same units.
+inline int32_t ClaimedWindowsMinWidth(double aDevicePixelsPerUnit) {
+  return int32_t(
+      std::round(WindowsMinTrackWidthDevicePixels(ClaimedWindowsDpr()) /
+                 aDevicePixelsPerUnit));
+}
+
+}  // namespace mozilla::widget
+
+#endif  // mozilla_widget_ClaimedWindowFrame_h
