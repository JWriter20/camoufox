+// Camoufox: a Windows identity's intra-family fallback waits for character
+// maps as Windows' does. DirectWrite families get their faces on demand but no
+// cmaps (gfxDWriteFontList::GetFacesInitDataForFamily, aLoadCmaps false), so
+// in a content process the first fallback within such a family finds it not
+// fully initialized: stock starts the parent's LoadCmapsRunnable from that
+// family to the end of the list and returns nothing (below), the character
+// goes to the next family -- the generic -- and when the pass ends the parent's
+// NotifyUpdatedFonts reflows, and the family's own face answers. Stock win-i9
+// (2026-10-31, 3 launches): "Microsoft JhengHei" (∑ж only in its Light face)
+// measured as the generics for 80-182 ms after its first lookup, then once and
+// for good as the Light face. Linux has the answer at once: the launcher turns
+// async fallback off there (fontconfig families would otherwise skip in the
+// global fallback). So under a Windows claim a family is answered only once a
+// pass covering it has landed; families before the pass's start stay unloaded,
+// and a lookup there rewinds a running pass (LoadCmapsRunnable::
+// MaybeResetIndex). As stock's shared font list, a landed pass holds for every
+// content process (a cross-origin frame opened later measured the Light face
+// at once on win-i9); a running pass is this process's. The launcher draws the
+// pass time (fonts:windowsCmapLoadMs) per launch.
+static mozilla::StaticMutex sWindowsCmapMutex MOZ_UNANNOTATED;
+// Families at or after this index have landed (this process's view).
+static uint32_t sWindowsCmapLoadedFrom = UINT32_MAX;
+// The running pass: its start, and when it lands (null: none running).
+static uint32_t sWindowsCmapPassFrom = UINT32_MAX;
+static mozilla::TimeStamp sWindowsCmapPassLandsAt;
+static std::atomic<uint32_t> sWindowsCmapReflowSchedule{0};
+// The browser-wide landed index, in the cross-process storage.
+static constexpr const char* kWindowsCmapLoadedKey = "wcmap_loaded_from_";
+
+// Called with sWindowsCmapMutex held: retire a pass whose time has come.
+static void WindowsCmapLandLocked(mozilla::TimeStamp aNow) {
+  if (!sWindowsCmapPassLandsAt.IsNull() && aNow >= sWindowsCmapPassLandsAt) {
+    sWindowsCmapLoadedFrom =
+        std::min(sWindowsCmapLoadedFrom, sWindowsCmapPassFrom);
+    sWindowsCmapPassLandsAt = mozilla::TimeStamp();
+    sWindowsCmapPassFrom = UINT32_MAX;
+  }
+}
+
+static void WindowsCmapReflowAt(mozilla::TimeStamp aAt, uint32_t aSchedule) {
+  if (aSchedule != sWindowsCmapReflowSchedule) {
+    return;
+  }
+  const mozilla::TimeDuration wait = aAt - mozilla::TimeStamp::Now();
+  if (wait > mozilla::TimeDuration()) {
+    NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction(
+            "WindowsCmapReflow",
+            [aAt, aSchedule] { WindowsCmapReflowAt(aAt, aSchedule); }),
+        uint32_t(wait.ToMilliseconds()) + 1);
+    return;
+  }
+  uint32_t landed;
+  {
+    mozilla::StaticMutexAutoLock lock(sWindowsCmapMutex);
+    WindowsCmapLandLocked(mozilla::TimeStamp::Now());
+    landed = sWindowsCmapLoadedFrom;
+  }
+  uint32_t shared = UINT32_MAX;
+  mozilla::dom::RoverfoxStorageManager::GetUint(kWindowsCmapLoadedKey, 0,
+                                                shared);
+  if (landed < shared) {
+    mozilla::dom::RoverfoxStorageManager::PutUint(u"wcmap_loaded_from_0"_ns,
+                                                  landed);
+  }
+  // As the content process does on the parent's RebuildFontList(false)
+  // (gfxPlatformFontList::UpdateFontList).
+  gfxPlatform::ForceGlobalReflow(gfxPlatform::GlobalReflowFlags::FontsChanged);
+}
+
+static bool WindowsCmapsPending(uint32_t aFamilyIndex,
+                                uint32_t aUserContextId) {
+  if (MaskConfig::HostOS() == MaskConfig::SpoofedOS::Windows ||
+      XRE_IsParentProcess() ||
+      mozilla::dom::NavigatorManager::GetSpoofedOS(aUserContextId) !=
+          MaskConfig::SpoofedOS::Windows) {
+    return false;
+  }
+  uint32_t shared = UINT32_MAX;
+  mozilla::dom::RoverfoxStorageManager::GetUint(kWindowsCmapLoadedKey, 0,
+                                                shared);
+  mozilla::StaticMutexAutoLock lock(sWindowsCmapMutex);
+  const auto now = mozilla::TimeStamp::Now();
+  WindowsCmapLandLocked(now);
+  if (aFamilyIndex >= std::min(sWindowsCmapLoadedFrom, shared)) {
+    return false;
+  }
+  if (sWindowsCmapPassLandsAt.IsNull() || aFamilyIndex < sWindowsCmapPassFrom) {
+    // A new pass, or a running one rewound to load this family too.
+    const auto loadMs =
+        MaskConfig::GetUint32("fonts:windowsCmapLoadMs").value_or(130);
+    const auto landsAt = now + mozilla::TimeDuration::FromMilliseconds(loadMs);
+    if (sWindowsCmapPassLandsAt.IsNull() || landsAt > sWindowsCmapPassLandsAt) {
+      sWindowsCmapPassLandsAt = landsAt;
+    }
+    sWindowsCmapPassFrom = std::min(sWindowsCmapPassFrom, aFamilyIndex);
+    const uint32_t schedule = ++sWindowsCmapReflowSchedule;
+    NS_DispatchToMainThread(NS_NewRunnableFunction(
+        "WindowsCmapReflow", [at = sWindowsCmapPassLandsAt, schedule] {
+          WindowsCmapReflowAt(at, schedule);
+        }));
+  }
+  return true;
+}
