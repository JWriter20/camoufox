+  // Camoufox: with media:spoof_codecs, canPlayType()/isTypeSupported() answer
+  // for the claimed OS rather than the host's decoders (media-codec-spoofing),
+  // so decodingInfo() must agree with them instead of asking the host: a Linux
+  // container claiming Windows otherwise reports H.264, HEVC and AAC
+  // unsupported, and VP9 software-only. Stock Firefox 158 on Windows 11
+  // reports H.264, HEVC, VP9 and AV1 at 720p, 1080p and 2160p, and Opus,
+  // supported, smooth and power-efficient. The RFP mask's rule for video
+  // still applies. An encrypted query takes the same decoder in the DRM
+  // branch above.
+  if (MaskConfig::GetBool("media:spoof_codecs")) {
+    bool hasVideo = false;
+    for (const auto& config : tracks) {
+      hasVideo |= config->IsVideo();
+    }
+    MediaCapabilitiesDecodingInfo info;
+    info.mSupported = true;
+    info.mSmooth = true;
+    info.mPowerEfficient = !(hasVideo && shouldResistFingerprinting);
+    LOG("spoofed {} -> {}", aConfiguration, info);
+    aPromise->MaybeResolve(std::move(info));
+    return;
+  }
+
   // Step 4: Otherwise, run the following steps:
