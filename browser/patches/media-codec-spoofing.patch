+// Camoufox: with media:spoof_codecs, whether the claimed OS's decoder for this
+// video track is power-efficient: decoded in hardware there (media:hwCodecs)
+// or small, the rule CreateVideoDecodingInfo applies to the host's answer.
+static bool SpoofedVideoPowerEfficient(const TrackInfo& aTrack) {
+  const std::vector<std::string> hwCodecs =
+      MaskConfig::GetStringList("media:hwCodecs");
+  const auto& image = aTrack.GetAsVideoInfo()->mImage;
+  const CheckedInt<uint32_t> pixels =
+      CheckedInt<uint32_t>(image.width) * CheckedInt<uint32_t>(image.height);
+  const bool lowResolution =
+      pixels.isValid() && pixels.value() <= kLowResolutionPixelCount;
+  const bool hardware =
+      std::find(hwCodecs.begin(), hwCodecs.end(),
+                std::string(aTrack.mMimeType.get())) != hwCodecs.end();
+  return hardware || lowResolution;
+}
