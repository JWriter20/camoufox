+        && static_prefs::pref!("network.http.http3.apple_fast_datapath")
+    {
+        // SAFETY: The probe has verified the APIs work on this OS version.
+        unsafe { s.enable_apple_fast_path() }
+    }
+    Ok(s)
+}
