+/// Camoufox: the connection is behind a SOCKS5 proxy. Nothing is sent until
+/// `neqo_http3conn_socks5_relay` or `neqo_http3conn_socks5_failed`. A proxy
+/// that resolves names is sent `name` in place of `placeholder`, the address
+/// the connection was made to; an empty `name` sends addresses.
+///
+/// # Safety
+///
+/// Use of raw (i.e. unsafe) pointers as arguments.
+#[no_mangle]
+pub unsafe extern "C" fn neqo_http3conn_socks5(
+    conn: &mut NeqoHttp3Conn,
+    name: &nsACString,
+    placeholder: *const NetAddr,
+) -> nsresult {
+    if conn.socket.is_none() {
+        return NS_ERROR_NOT_AVAILABLE;
+    }
+    conn.socks5 = if name.is_empty() {
+        Some(socks5::Relay::new())
+    } else {
+        let placeholder = match netaddr_to_socket_addr(placeholder) {
+            Ok(a) => a,
+            Err(e) => return e,
+        };
+        match socks5::Relay::named(name, placeholder) {
+            Some(r) => Some(r),
+            None => return NS_ERROR_INVALID_ARG,
+        }
+    };
+    NS_OK
+}
+
+/// Camoufox: the UDP ASSOCIATE was granted. `socket` reaches the relay, and
+/// `replaced` says it is not the one the connection was made with (the relay's
+/// address family differs from the peer's).
+///
+/// # Safety
+///
+/// Use of raw (i.e. unsafe) pointers as arguments.
+#[no_mangle]
+pub unsafe extern "C" fn neqo_http3conn_socks5_relay(
+    conn: &mut NeqoHttp3Conn,
+    relay: *const NetAddr,
+    socket: i64,
+    replaced: bool,
+) -> nsresult {
+    let relay = match netaddr_to_socket_addr(relay) {
+        Ok(relay) => relay,
+        Err(e) => return e,
+    };
+    if replaced {
+        match borrow_socket(socket) {
+            Ok(s) => conn.socket = Some(s),
+            Err(e) => return e,
+        }
+    }
+    // After the socket is borrowed: borrowing forbids fragmenting.
+    if let Err(e) = socks5::allow_fragmenting(socket, relay.is_ipv4()) {
+        qwarn!("the socket to the SOCKS5 relay keeps don't-fragment: {e}");
+    }
+    let Some(socks5) = conn.socks5.as_mut() else {
+        return NS_ERROR_UNEXPECTED;
+    };
+    socks5.set_relay(relay);
+    NS_OK
+}
+
+/// Camoufox: the proxy carries no UDP for this connection.
+#[no_mangle]
+pub extern "C" fn neqo_http3conn_socks5_failed(conn: &mut NeqoHttp3Conn) {
+    if let Some(socks5) = conn.socks5.as_mut() {
+        socks5.set_failed();
+    }
+}
+
 #[no_mangle]
 pub extern "C" fn neqo_http3conn_close(conn: &mut NeqoHttp3Conn, error: u64) {
     conn.conn.close(Instant::now(), error, "");
