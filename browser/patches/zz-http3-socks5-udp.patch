+TimeDuration HappyEyeballsConnectionAttempt::DnsLost() {
+  nsProxyInfo* proxy = mConnInfo->ProxyInfo();
+  if (mDnsAsked.IsNull() || !proxy || !proxy->ConnectsAsDirect()) {
+    return mDnsLost;
