+         static_cast<uint32_t>(rv), this));
+    aSocket->Close();
+    return rv;
+  }
+
+  if (aFamily == AF_INET) {
+    rv = aSocket->SetDontFragment(true);
+    if (NS_FAILED(rv)) {
+      LOG(("HttpConnectionUDP::BindSocket SetDontFragment failed %d [this=%p]",
+           static_cast<uint32_t>(rv), this));
+    }
+  }
