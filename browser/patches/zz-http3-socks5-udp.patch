+/// Camoufox: the connection is behind a SOCKS5 proxy. Nothing is sent until
+/// `neqo_http3conn_socks5_relay` or `neqo_http3conn_socks5_failed`.
+#[no_mangle]
+pub extern "C" fn neqo_http3conn_socks5(conn: &mut NeqoHttp3Conn) -> nsresult {
+    if conn.socket.is_none() {
+        return NS_ERROR_NOT_AVAILABLE;
+    }
+    conn.socks5 = Some(socks5::Relay::new());
+    NS_OK
