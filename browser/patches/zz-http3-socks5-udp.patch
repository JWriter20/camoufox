diff --git a/netwerk/base/Socks5UdpAssociation.h b/netwerk/base/Socks5UdpAssociation.h
new file mode 100644
index 0000000000..65eaee8c4e
--- /dev/null
+++ b/netwerk/base/Socks5UdpAssociation.h
@@ -0,0 +1,83 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_net_Socks5UdpAssociation_h
+#define mozilla_net_Socks5UdpAssociation_h
+
+#include "mozilla/TimeStamp.h"
+#include "mozilla/net/DNS.h"
+#include "nsCOMPtr.h"
+#include "nsIAsyncInputStream.h"
+#include "nsIAsyncOutputStream.h"
+#include "nsISupportsImpl.h"
+#include "nsString.h"
+#include "nsTArray.h"
+
+class nsIEventTarget;
+class nsISocketTransport;
+
+namespace mozilla {
+namespace net {
+
+// Camoufox: what a UDP ASSOCIATE tells the socket it serves, on the socket
+// thread. OnRelayFailed() ends it: a proxy that is not SOCKS5, one that
+// refuses the association, or a control connection that closed.
+class Socks5UdpAssociationOwner {
+ public:
+  virtual void OnRelayReady(const NetAddr& aRelay) = 0;
+  virtual void OnRelayFailed() = 0;
+
+ protected:
+  virtual ~Socks5UdpAssociationOwner() = default;
+};
+
+// Camoufox: a SOCKS5 UDP ASSOCIATE (RFC 1928 §7), for the life of the UDP
+// socket it serves: one per ICE socket and one per QUIC connection, as each
+// has one UDP socket of its own without a proxy. The control connection runs
+// from the process that sends the datagrams, so the relay sees both from the
+// same address.
+class Socks5UdpAssociation final : public nsIInputStreamCallback,
+                                   public nsIOutputStreamCallback {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+  NS_DECL_NSIINPUTSTREAMCALLBACK
+  NS_DECL_NSIOUTPUTSTREAMCALLBACK
+
+  // aOwner must call Close() before it goes away.
+  explicit Socks5UdpAssociation(Socks5UdpAssociationOwner* aOwner);
+  // On the socket thread, once, with the proxy the owner's traffic uses
+  // (nsIProxyInfo's type, host, port and credentials).
+  void Connect(const nsACString& aType, const nsACString& aHost, int32_t aPort,
+               const nsACString& aUsername, const nsACString& aPassword);
+  void Close();
+  // How long the proxy took to answer the UDP ASSOCIATE request: one round
+  // trip to it. Zero until the relay is ready.
+  TimeDuration RoundTrip() const { return mRoundTrip; }
+
+ private:
+  ~Socks5UdpAssociation();
+
+  void Parse();
+  void Send(const nsTArray<uint8_t>& aBytes);
+  void Fail(const char* aWhy);
+
+  enum class Step { Proxy, Greeting, Auth, Reply, Associated, Done };
+  Step mStep = Step::Proxy;
+  Socks5UdpAssociationOwner* mOwner;
+  nsCString mUsername;
+  nsCString mPassword;
+  nsCOMPtr<nsIEventTarget> mSocketThread;
+  nsCOMPtr<nsISocketTransport> mTransport;
+  nsCOMPtr<nsIAsyncInputStream> mIn;
+  nsCOMPtr<nsIAsyncOutputStream> mOut;
+  nsTArray<uint8_t> mInBuf;
+  nsTArray<uint8_t> mOutBuf;
+  TimeStamp mAsked;
+  TimeDuration mRoundTrip;
+};
+
+}  // namespace net
+}  // namespace mozilla
+
+#endif  // mozilla_net_Socks5UdpAssociation_h
