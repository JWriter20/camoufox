new file mode 100644
index 0000000000..682969c355
--- /dev/null
+++ b/netwerk/socket/neqo_glue/src/socks5.rs
@@ -0,0 +1,190 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Camoufox: a QUIC connection behind a SOCKS5 proxy sends its datagrams to
+//! the relay of a UDP ASSOCIATE (RFC 1928 §7), each under the request header
+//! naming where it goes, and reads the peer's from the same relay. The
+//! association is made by `mozilla::net::Socks5UdpAssociation`; this is only
+//! the framing, so the socket, its ECN marks and its batching stay the ones a
+//! direct connection uses.
+
+use std::{
+    io,
+    net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr},
+    num::NonZeroUsize,
+};
+
+use libc::c_int;
+use neqo_common::datagram;
+
+/// One datagram to a send: the kernel refuses a segmented send whose segments
+/// do not fit the link, where a single datagram is fragmented
+/// (`allow_fragmenting`).
+pub const MAX_SEGMENTS: usize = 1;
+
+const ATYP_IPV4: u8 = 1;
+const ATYP_IPV6: u8 = 4;
+
+enum State {
+    /// The association is being made. Nothing is sent: the handshake starts
+    /// when it can leave, as it does with no proxy.
+    Pending,
+    Relay(SocketAddr),
+    /// The proxy carries no UDP. Datagrams are dropped silently, as on a
+    /// machine whose UDP is blocked, so the fall back to TCP is stock's.
+    Failed,
+}
+
+pub struct Relay {
+    state: State,
+}
+
+impl Relay {
+    pub const fn new() -> Self {
+        Self {
+            state: State::Pending,
+        }
+    }
+
+    pub fn set_relay(&mut self, relay: SocketAddr) {
+        self.state = State::Relay(relay);
+    }
+
+    pub fn set_failed(&mut self) {
+        self.state = State::Failed;
+    }
+
+    pub const fn pending(&self) -> bool {
+        matches!(self.state, State::Pending)
+    }
+
+    fn header(to: SocketAddr) -> Vec<u8> {
+        let mut h = vec![0, 0, 0];
+        match to.ip() {
+            IpAddr::V4(ip) => {
+                h.push(ATYP_IPV4);
+                h.extend_from_slice(&ip.octets());
+            }
+            IpAddr::V6(ip) => {
+                h.push(ATYP_IPV6);
+                h.extend_from_slice(&ip.octets());
+            }
+        }
+        h.extend_from_slice(&to.port().to_be_bytes());
+        h
+    }
+
+    /// The batch as the relay takes it, or `None` when it is to be dropped.
+    /// Every segment grows by the same header, so the batch stays one a
+    /// segmenting socket accepts.
+    pub fn wrap(&self, batch: &datagram::Batch) -> Option<datagram::Batch> {
+        let State::Relay(relay) = self.state else {
+            return None;
+        };
+        let header = Self::header(batch.destination());
+        let size = batch.datagram_size().get();
+        let mut data =
+            Vec::with_capacity(batch.data().len() + batch.num_datagrams() * header.len());
+        for segment in batch.data().chunks(size) {
+            data.extend_from_slice(&header);
+            data.extend_from_slice(segment);
+        }
+        Some(datagram::Batch::new(
+            batch.source(),
+            relay,
+            batch.tos(),
+            NonZeroUsize::new(size + header.len()).expect("not zero"),
+            data,
+        ))
+    }
+
+    /// The sender and payload of a datagram received from `from`. `None` for
+    /// one that is not the relay's, a fragment, or malformed.
+    pub fn unwrap<'a>(&self, from: SocketAddr, d: &'a [u8]) -> Option<(SocketAddr, &'a [u8])> {
+        let State::Relay(relay) = self.state else {
+            return None;
+        };
+        if canonical(from) != canonical(relay) || d.len() < 4 || d[..3] != [0, 0, 0] {
+            return None;
+        }
+        let (ip, rest) = match d[3] {
+            ATYP_IPV4 => {
+                let ip: [u8; 4] = d.get(4..8)?.try_into().ok()?;
+                (IpAddr::V4(Ipv4Addr::from(ip)), &d[8..])
+            }
+            ATYP_IPV6 => {
+                let ip: [u8; 16] = d.get(4..20)?.try_into().ok()?;
+                (IpAddr::V6(Ipv6Addr::from(ip)), &d[20..])
+            }
+            _ => return None,
+        };
+        let port: [u8; 2] = rest.get(..2)?.try_into().ok()?;
+        let payload = &rest[2..];
+        if payload.is_empty() {
+            return None;
+        }
+        Some((SocketAddr::new(ip, u16::from_be_bytes(port)), payload))
+    }
+}
+
+/// Lets a datagram to the relay be fragmented, undoing what the QUIC socket
+/// is set up with. The peer must receive the datagram a direct connection
+/// sends it, so it is not made smaller; with the relay header on it, it no
+/// longer fits a link that carries it bare (1252 bytes of QUIC is a 1280-byte
+/// IPv4 packet). Only the hop to the relay may fragment: the relay sends on a
+/// whole datagram.
+pub fn allow_fragmenting(socket: i64, ipv4: bool) -> io::Result<()> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    let options: &[(c_int, c_int, c_int)] = if ipv4 {
+        &[(libc::IPPROTO_IP, libc::IP_MTU_DISCOVER, libc::IP_PMTUDISC_DONT)]
+    } else {
+        &[
+            (libc::IPPROTO_IPV6, libc::IPV6_MTU_DISCOVER, libc::IPV6_PMTUDISC_WANT),
+            (libc::IPPROTO_IPV6, libc::IPV6_DONTFRAG, 0),
+        ]
+    };
+    #[cfg(all(unix, not(any(target_os = "linux", target_os = "android"))))]
+    let options: &[(c_int, c_int, c_int)] = if ipv4 {
+        &[(libc::IPPROTO_IP, libc::IP_DONTFRAG, 0)]
+    } else {
+        &[(libc::IPPROTO_IPV6, libc::IPV6_DONTFRAG, 0)]
+    };
+    // Winsock's IP_DONTFRAGMENT and IPV6_DONTFRAG are both 14.
+    #[cfg(windows)]
+    let options: &[(c_int, c_int, c_int)] = if ipv4 { &[(0, 14, 0)] } else { &[(41, 14, 0)] };
+
+    for (level, name, value) in options {
+        #[cfg(unix)]
+        // SAFETY: `value` is a c_int that outlives the call.
+        let failed = unsafe {
+            libc::setsockopt(
+                socket as c_int,
+                *level,
+                *name,
+                std::ptr::from_ref(value).cast(),
+                size_of::<c_int>() as libc::socklen_t,
+            )
+        } != 0;
+        #[cfg(windows)]
+        // SAFETY: `value` is a 4-byte integer that outlives the call.
+        let failed = unsafe {
+            winapi::um::winsock2::setsockopt(
+                socket as winapi::um::winsock2::SOCKET,
+                *level,
+                *name,
+                std::ptr::from_ref(value).cast(),
+                size_of::<c_int>() as c_int,
+            )
+        } != 0;
+        if failed {
+            return Err(io::Error::last_os_error());
+        }
+    }
+    Ok(())
+}
+
+/// A dual-stack socket reports an IPv4 sender as an IPv4-mapped address.
+fn canonical(addr: SocketAddr) -> SocketAddr {
+    SocketAddr::new(addr.ip().to_canonical(), addr.port())
+}
