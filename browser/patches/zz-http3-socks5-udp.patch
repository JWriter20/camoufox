+Maybe<TimeDuration> nsHttpConnectionMgr::Http3RelayLag(
+    nsHttpConnectionInfo* ci, uint32_t aRoundTrips) {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  ConnectionEntry* ent = mCT.GetWeak(ci->HashKey());
