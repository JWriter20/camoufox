+
+// Camoufox: the relay is reached from a socket of its own address family,
+// which is the proxy's and not always the peer's.
+void HttpConnectionUDP::OnRelayReady(const NetAddr& aRelay) {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  mRelayPending = false;
+  if (!mHttp3Session || !mSocket) {
+    return;
+  }
+  if (mHttp3Session->IsClosing()) {
+    // Closed before it could send: all it has to say is that it closed, to a
+    // peer that never heard of it. With no proxy the peer has its first
+    // flight by then.
+    mHttp3Session->Socks5Failed();
+    return;
+  }
+  NetAddr peer;
+  mPeerAddr->GetNetAddr(&peer);
+  nsCOMPtr<nsIUDPSocket> replaced;
+  if (aRelay.raw.family != peer.raw.family) {
+    nsresult rv;
+    nsCOMPtr<nsIUDPSocket> socket =
+        do_CreateInstance("@mozilla.org/network/udp-socket;1", &rv);
+    if (NS_FAILED(rv) || NS_FAILED(BindSocket(socket, aRelay.raw.family))) {
+      return OnRelayFailed();
+    }
+    socket->SetOriginAttributes(mConnInfo->GetOriginAttributes());
+    if (NS_FAILED(socket->SyncListen(this))) {
+      socket->Close();
+      return OnRelayFailed();
+    }
+    replaced = std::move(mSocket);
+    mSocket = socket;
+  }
+  if (NS_FAILED(mHttp3Session->Socks5Relay(
+          aRelay, mSocket->GetFileDescriptor(), !!replaced))) {
+    return OnRelayFailed();
+  }
+  if (replaced) {
+    replaced->Close();
+  }
+  mRelayReady = true;
+  mRelaySetup = TimeStamp::Now() - mRelayAsked;
+  (void)SendData();
+}
+
+Maybe<TimeDuration> HttpConnectionUDP::RelayLag(uint32_t aRoundTrips) const {
+  if (mRelayPending) {
+    return Some(TimeDuration::Forever());
+  }
+  return mRelayReady ? Some(mRelaySetup +
+                            mSocks5->RoundTrip().MultDouble(aRoundTrips))
+                     : Nothing();
+}
+
+TimeDuration HttpConnectionUDP::RelayLost() const {
+  if (mRelayPending) {
+    return TimeStamp::Now() - mRelayAsked;
+  }
+  return mSocks5 ? RelayLag(1).valueOr(TimeDuration()) : TimeDuration();
+}
+
+void HttpConnectionUDP::OnRelayFailed() {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  mRelayPending = false;
+  if (!mHttp3Session) {
+    return;
+  }
+  mHttp3Session->Socks5Failed();
+  if (mRelayReady) {
+    // An association lost in use is a socket that failed, which ends the
+    // connection at once. Its requests go to a new one instead of waiting
+    // out the idle timeout.
+    RefPtr<HttpConnectionUDP> self(this);
+    CloseTransaction(mHttp3Session, NS_ERROR_NET_RESET);
+    return;
+  }
+  (void)SendData();
+}
