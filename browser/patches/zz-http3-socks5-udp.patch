+static StaticMutex sAnswerTimeLock;
+static TimeDuration sAnswerTime MOZ_GUARDED_BY(sAnswerTimeLock);
+static TimeDuration sAnswerTimeVariation MOZ_GUARDED_BY(sAnswerTimeLock);
+
+// static
+void TRRService::AnswerTook(TimeDuration aTime) {
+  StaticMutexAutoLock lock(sAnswerTimeLock);
+  if (!sAnswerTime) {
+    sAnswerTime = aTime;
+    sAnswerTimeVariation = aTime / int64_t(2);
+    return;
+  }
+  // RFC 6298 section 2.3: beta is 1/4 and alpha 1/8.
+  const TimeDuration off =
+      aTime > sAnswerTime ? aTime - sAnswerTime : sAnswerTime - aTime;
+  sAnswerTimeVariation = (sAnswerTimeVariation * 3 + off) / int64_t(4);
+  sAnswerTime = (sAnswerTime * 7 + aTime) / int64_t(8);
+}
+
+// static
+TimeDuration TRRService::AnswerTimeout() {
+  StaticMutexAutoLock lock(sAnswerTimeLock);
+  return sAnswerTime + sAnswerTimeVariation * 4;
+}
+
+static uint32_t sQueriesWaiting MOZ_GUARDED_BY(sAnswerTimeLock);
+static TimeStamp sQueriesWaitingSince MOZ_GUARDED_BY(sAnswerTimeLock);
+static TimeDuration sQueriesWaited MOZ_GUARDED_BY(sAnswerTimeLock);
+
+// static
+void TRRService::QueryWaiting() {
+  StaticMutexAutoLock lock(sAnswerTimeLock);
+  if (!sQueriesWaiting++) {
+    sQueriesWaitingSince = TimeStamp::Now();
+  }
+}
+
+// static
+void TRRService::QuerySent() {
+  StaticMutexAutoLock lock(sAnswerTimeLock);
+  MOZ_RELEASE_ASSERT(sQueriesWaiting);
+  if (!--sQueriesWaiting) {
+    sQueriesWaited += TimeStamp::Now() - sQueriesWaitingSince;
+  }
+}
+
+// static
+TimeDuration TRRService::QueriesWaited() {
+  StaticMutexAutoLock lock(sAnswerTimeLock);
+  if (!sQueriesWaiting) {
+    return sQueriesWaited;
+  }
+  return sQueriesWaited + (TimeStamp::Now() - sQueriesWaitingSince);
+}
