+
+Maybe<TimeDuration> nsHttpConnectionMgr::Http3BlockerRelayLag(
+    nsHttpTransaction* aTrans, uint32_t aRoundTrips) {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  Maybe<TimeDuration> longest;
+  nsIRequestContext* context = aTrans->RequestContext();
+  if (!context) {
+    return longest;
+  }
+  for (const auto& active : mActiveTransactions) {
+    const nsTArray<RefPtr<nsHttpTransaction>>* transactions =
+        active.Get(aTrans->BrowserId());
+    if (!transactions) {
+      continue;
+    }
+    for (const auto& trans : *transactions) {
+      if (trans == aTrans || trans->RequestContext() != context ||
+          !trans->IsDispatchedAsBlocking()) {
+        continue;
+      }
+      Maybe<TimeDuration> lag =
+          Http3RelayLag(trans->ConnectionInfo(), aRoundTrips);
+      if (lag && (!longest || *lag > *longest)) {
+        longest = lag;
+      }
+    }
+  }
+  return longest;
+}
