+// Camoufox: the timers that start a TCP connection beside an HTTP/3 one give
+// QUIC that long to answer. Behind a SOCKS5 proxy QUIC's first datagram waits
+// for the relay, and its answer crosses the proxy, so a timer that ran out
+// starts again for what that cost (HttpConnectionUDP::RelayLag): TCP is tried
+// when a Firefox at the proxy's exit would try it. aDelay, the timer's own
+// length, is how often a relay still being set up is looked at again; the
+// lag is longer than that, so the look after the relay is ready comes before
+// the timer is due. The timers run for a request held back by its page's
+// blocking ones too (a stylesheet), which has no connection yet: it waits for
+// what the proxy cost those, a handshake and a response. Let go by then, as
+// it would be at the exit, it waits for its own relay. Still held back, it
+// starts TCP, which is going to race a QUIC connection that has not been
+// asked for. A ClientHello sent behind the CONNECT request reaches the origin
+// a round trip to the proxy sooner than a first datagram, which waits for the
+// reply to UDP ASSOCIATE, so OnBackupConnectionReady gives that head start
+// back before it takes the request from QUIC.
+bool nsHttpTransaction::FallbackWaitsForRelay(nsCOMPtr<nsITimer>& aTimer,
+                                              uint32_t aDelay) {
+  if (!mConnInfo->ProxyCarriesUdp()) {
+    return false;
+  }
+  nsHttpConnectionMgr* mgr = gHttpHandler->ConnMgr();
+  bool* waited = &mFallbackWaitedForRelay;
+  Maybe<TimeDuration> lag = mgr->Http3RelayLag(mConnInfo, 1);
+  if (!lag && !mConnection) {
+    waited = &mFallbackWaitedForBlocker;
+    lag = mgr->Http3BlockerRelayLag(this, 2);
+    Maybe<TimeDuration> more = mgr->Http3BlockerRelayLag(this, 3);
+    if (*waited && lag && more && *more != TimeDuration::Forever() &&
+        StaticPrefs::network_proxy_socks5_optimistic_data()) {
+      mBackupHeadStart = *more - *lag;
+    }
+  }
+  if (!lag || *waited) {
+    return false;
+  }
+  const TimeStamp now = TimeStamp::Now();
+  if (mFallbackDue.IsNull()) {
+    mFallbackDue = now;
+  }
+  if (*lag == TimeDuration::Forever()) {
+    CreateAndStartTimer(aTimer, this, aDelay);
+    return !!aTimer;
+  }
+  *waited = true;
+  mFallbackDue += *lag;
+  const double left = (mFallbackDue - now).ToMilliseconds();
+  if (left < 1) {
+    return false;
+  }
+  CreateAndStartTimer(aTimer, this, static_cast<uint32_t>(left));
+  return !!aTimer;
+}
