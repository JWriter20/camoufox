   bool IsHTTP();
   bool IsHTTPS();
   bool IsSOCKS();
+  // Camoufox: SOCKS5, which relays UDP (UDP ASSOCIATE) as well as TCP.
+  bool IsSOCKS5();
+  // Camoufox: no proxy, or a SOCKS5 proxy that is given the addresses this
