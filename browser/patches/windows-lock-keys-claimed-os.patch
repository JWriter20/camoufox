+// Camoufox: a Windows identity on another OS reads its keyboard as Windows
+// does (cfparity input.keys.numpad / input.keys.modifiers on win-i9, stock
+// Firefox 158.0.1, SendInput, 3 launches alike).
+static bool ClaimsWindowsKeyboardState() {
+  static const bool sClaims =
+      MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows &&
+      MaskConfig::HostOS() != MaskConfig::SpoofedOS::Windows;
+  return sClaims;
+}
