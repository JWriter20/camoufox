+int NrUdpRelaySocket::SendToRelay(const nsTArray<uint8_t>& aDatagram,
+                                  int aFlags) {
+  if (relay_) {
+    return relay_->sendto(aDatagram.Elements(), aDatagram.Length(), aFlags,
+                          &relay_addr_);
+  }
+  // NrSocket::sendto would refuse the relay: it is off this host.
+  PRNetAddr naddr;
+  if (nr_transport_addr_to_praddr(&relay_addr_, &naddr)) {
+    return R_BAD_ARGS;
+  }
+  const int32_t sent = PR_SendTo(fd_, aDatagram.Elements(), aDatagram.Length(),
+                                 aFlags, &naddr, PR_INTERVAL_NO_WAIT);
+  if (sent < 0 || static_cast<size_t>(sent) != aDatagram.Length()) {
+    return PR_GetError() == PR_WOULD_BLOCK_ERROR ? R_WOULDBLOCK : R_IO_ERROR;
+  }
+  return 0;
+}
