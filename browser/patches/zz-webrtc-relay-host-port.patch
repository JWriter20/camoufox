+bool NrUdpRelaySocket::Unframe(size_t aGot, void* buf, size_t maxlen,
+                               size_t* len, nr_transport_addr* from) {
+  const uint8_t* p = recv_buf_.Elements();
+  // Only unfragmented.
+  if (aGot < 4 || p[0] || p[1] || p[2]) {
+    return false;
+  }
+  size_t header;
+  uint16_t nport;
+  if (p[3] == 1 && aGot >= 10) {
+    uint32_t ip;
+    memcpy(&ip, p + 4, 4);
+    memcpy(&nport, p + 8, 2);
+    nr_ip4_port_to_transport_addr(ntohl(ip), ntohs(nport), IPPROTO_UDP, from);
+    header = 10;
+  } else if (p[3] == 4 && aGot >= 22) {
+    in6_addr ip;
+    memcpy(&ip, p + 4, 16);
+    memcpy(&nport, p + 20, 2);
+    nr_ip6_port_to_transport_addr(&ip, ntohs(nport), IPPROTO_UDP, from);
+    header = 22;
+  } else {
+    return false;
+  }
+  // A relay read is larger than the caller's buffer, by the header's maximum.
+  if (aGot - header > maxlen) {
+    return false;
+  }
+  *len = aGot - header;
+  memcpy(buf, p + header, *len);
+  return true;
 }
 
