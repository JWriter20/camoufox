+// Camoufox: a drag under a Windows identity holds back the mouse moves that
+// reach the page between dragstart and dragend. Windows Firefox runs the drag
+// in DoDragDrop's modal OLE loop: the WM_MOUSEMOVE queued behind the move that
+// started it stays in the window's queue until the loop returns, and the page
+// gets it after dragend with the button still held, the time it was made and
+// its movement from the move before (win-i9, Firefox 158.0.1, cfparity
+// driven.drag 3/3: pointermove/mousemove at the second move after the press,
+// buttons 1, movement [20, 5], after dragend). GTK takes the pointer only at
+// the drag's first motion, so the moves before it reached the page at once.
+// They wait here, in order, until dragend (RecvEndDragSession). Juggler's own
+// moves are left alone: Juggler orders a driven drag itself (PageHandler).
+bool BrowserChild::HoldClaimedOSDragMove(const WidgetMouseEvent& aMouseEvent,
+                                         const ScrollableLayerGuid& aGuid,
+                                         uint64_t aInputBlockId) {
+  if (MaskConfig::HostOS() == MaskConfig::SpoofedOS::Windows ||
+      aMouseEvent.mMessage != eMouseMove || aMouseEvent.mJugglerEventId ||
+      aMouseEvent.IsSynthesized()) {
+    return false;
+  }
+  RefPtr<nsIDragSession> session = GetDragSession();
+  nsCOMPtr<nsINode> sourceNode;
+  if (session) {
+    session->GetSourceNode(getter_AddRefs(sourceNode));
+  }
+  if (!sourceNode) {
+    // The drag ended without telling this process (no RecvEndDragSession):
+    // what it held goes first.
+    ReleaseClaimedOSDragMoves();
+    return false;
+  }
+  if (NavigatorManager::GetSpoofedOS(
+          RoverfoxStorageManager::UserContextId(sourceNode)) !=
+      MaskConfig::SpoofedOS::Windows) {
+    return false;
+  }
+  if (mClaimedOSHeldMoves.Length() >= 8) {
+    mClaimedOSHeldMoves.RemoveElementAt(0);
+  }
+  mClaimedOSHeldMoves.AppendElement(MakeUnique<ClaimedOSHeldMove>(
+      ClaimedOSHeldMove{aMouseEvent, aGuid, aInputBlockId}));
+  return true;
+}
+
+void BrowserChild::ReleaseClaimedOSDragMoves() {
+  nsTArray<UniquePtr<ClaimedOSHeldMove>> held =
+      std::move(mClaimedOSHeldMoves);
+  for (const UniquePtr<ClaimedOSHeldMove>& move : held) {
+    (void)RecvRealMouseMoveEvent(move->mEvent, move->mGuid,
+                                 move->mInputBlockId);
+  }
+}
