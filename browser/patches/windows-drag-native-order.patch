+// Camoufox: a drag that started in this browser (it has a source node) is in
+// progress over this window (OnLeaveNotifyEvent).
+bool nsWindow::IsSourceDragInProgress() {
+  nsCOMPtr<nsIDragService> dragService =
+      do_GetService("@mozilla.org/widget/dragservice;1");
+  if (!dragService) {
+    return false;
+  }
+  nsCOMPtr<nsIDragSession> session = dragService->GetCurrentSession(this);
+  if (!session) {
+    return false;
+  }
+  nsCOMPtr<nsINode> sourceNode;
+  session->GetSourceNode(getter_AddRefs(sourceNode));
+  return !!sourceNode;
+}
