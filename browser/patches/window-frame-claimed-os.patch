+// Camoufox: the frame a Windows identity's window has. Windows Firefox draws
+// its tabs in the titlebar, so a normal window's client area runs to the top
+// edge, and the window rect carries the invisible resize border on the other
+// three sides; a maximized window overhangs the work area by that border on
+// all four; fullscreen has none. Without this, outerWidth/outerHeight,
+// screenX/screenY and mozInnerScreenX/Y answered with this host's window
+// manager decorations (openbox: a 1px border and an 8 CSS px titlebar).
+//
+// The border is SM_CXFRAME + SM_CXPADDEDBORDER at the display's DPI, in device
+// pixels, and the identity's devicePixelRatio is that DPI. Measured with
+// stock Firefox: 8 at 96 DPI (dpr 1) and 16 at 240 DPI (dpr 2.5, win-i9,
+// outerWidth - innerWidth = 12.8). Between those it follows 3 +
+// round(dpr) + round(4 * dpr), which reproduces both and the recorded
+// population's 7 CSS px at dpr 1.25, 1.5 and 2.
+static int32_t WindowsResizeBorderDevicePixels(double aDpr) {
+  auto roundHalfUp = [](double v) { return int32_t(std::floor(v + 0.5)); };
+  return 3 + roundHalfUp(aDpr) + roundHalfUp(4 * aDpr);
+}
+
+// A window that does not draw in its titlebar (a pop-up) has Windows's
+// caption above the client area: SM_CYCAPTION,
+// the NONCLIENTMETRICS caption height (22 at 96 DPI) scaled to the DPI plus
+// one, so the client area starts this far below the resize border. With the
+// border, it reproduces within a device pixel what stock Firefox 158 on win-i9
+// put above a window.open pop-up's toolbar at 100, 125, 150, 175, 200, 225
+// and 250 % (31, 38, 45, 52, 58, 64 and 72 device px).
+static int32_t WindowsCaptionDevicePixels(double aDpr) {
+  return int32_t(std::floor(22 * aDpr + 0.5)) + 1;
+}
+
+// Whether Windows Firefox would draw this window's tabs in its titlebar. It
+// does for every window with a toolbar, and not for a pop-up opened without
+// one (TabBarVisibility: CustomTitlebar.allowedBy("non-popup")), which keeps
+// the system caption. On this host the answer cannot come from
+// mDrawInTitlebar: GTK only draws in the titlebar where client-side
+// decorations are available, and a window manager without them (openbox)
+// leaves every window with a system titlebar.
+bool nsWindow::ClaimsCustomTitlebar() const {
+  if (mDrawInTitlebar) {
+    return true;
+  }
+  nsIAppWindow* appWindow =
+      mWidgetListener ? mWidgetListener->GetAppWindow() : nullptr;
+  uint32_t flags = 0;
+  return appWindow && NS_SUCCEEDED(appWindow->GetChromeFlags(&flags)) &&
+         (flags & nsIWebBrowserChrome::CHROME_TOOLBAR);
+}
+
+// Windows keeps a window at least SM_CXMINTRACK wide: the caption's buttons,
+// icon and borders. Stock Firefox 158 on win-i9, a window.open pop-up asked
+// for 100 CSS px: 136, 166, 198, 231, 258, 291 and 325 device px wide at 100,
+// 125, 150, 175, 200, 225 and 250 %. It does not follow one rounding of the
+// DPI, so it is the measured values, linear between them.
+static int32_t WindowsMinTrackWidthDevicePixels(double aDpr) {
+  static constexpr double kDpr[] = {1, 1.25, 1.5, 1.75, 2, 2.25, 2.5};
+  static constexpr double kWidth[] = {136, 166, 198, 231, 258, 291, 325};
+  constexpr size_t kLast = std::size(kDpr) - 1;
+  if (aDpr <= kDpr[0]) {
+    return int32_t(std::round(kWidth[0] * aDpr / kDpr[0]));
+  }
+  if (aDpr >= kDpr[kLast]) {
+    return int32_t(std::round(kWidth[kLast] * aDpr / kDpr[kLast]));
+  }
+  size_t i = 1;
+  while (kDpr[i] < aDpr) {
+    i++;
+  }
+  const double t = (aDpr - kDpr[i - 1]) / (kDpr[i] - kDpr[i - 1]);
+  return int32_t(std::round(kWidth[i - 1] + t * (kWidth[i] - kWidth[i - 1])));
+}
+
+int32_t nsWindow::ClaimedMinWidth() const {
+  if (!IsTopLevelWidget() || IsPopup() || mSizeMode != nsSizeMode_Normal ||
+      MaskConfig::GetSpoofedOS() != MaskConfig::SpoofedOS::Windows ||
+      MaskConfig::HostOS() == MaskConfig::SpoofedOS::Windows) {
+    return 0;
+  }
+  const double dpr =
+      MaskConfig::GetDouble("window.devicePixelRatio").value_or(1.0);
+  return int32_t(std::round(WindowsMinTrackWidthDevicePixels(dpr) /
+                            FractionalScaleFactor()));
+}
+
+DesktopIntMargin nsWindow::ClaimedClientMargin(
+    const DesktopIntMargin& aNative) const {
+  if (!IsTopLevelWidget() || IsPopup() ||
+      MaskConfig::GetSpoofedOS() != MaskConfig::SpoofedOS::Windows ||
+      MaskConfig::HostOS() == MaskConfig::SpoofedOS::Windows) {
+    return aNative;
+  }
+  if (mSizeMode == nsSizeMode_Fullscreen) {
+    return {};
+  }
+  const double dpr =
+      MaskConfig::GetDouble("window.devicePixelRatio").value_or(1.0);
+  const int32_t border = int32_t(std::round(
+      WindowsResizeBorderDevicePixels(dpr) / FractionalScaleFactor()));
+  if (mSizeMode == nsSizeMode_Maximized) {
+    return DesktopIntMargin(border, border, border, border);
+  }
+  if (!ClaimsCustomTitlebar()) {
+    const int32_t caption = int32_t(std::round(
+        WindowsCaptionDevicePixels(dpr) / FractionalScaleFactor()));
+    return DesktopIntMargin(border + caption, border, border, border);
+  }
+  return DesktopIntMargin(0, border, border, border);
+}
+
 bool nsWindow::DrawsToCSDTitlebar() const {
   return mGtkWindowDecoration == GTK_DECORATION_CLIENT && mDrawInTitlebar;
 }
