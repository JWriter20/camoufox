+  // Camoufox: a Windows identity's work area is the one its screen.avail*
+  // claims (the taskbar's 48 CSS px off the bottom on win-i9), not this X
+  // screen's. Windows Firefox sizes and places new windows inside the work
+  // area -- window.open's default size, a pop-up taller than the screen, the
+  // clamp that keeps a window on screen -- so with the X work area a pop-up
+  // was 864 CSS px tall where stock's is 816, and one opened without a size
+  // sat 48 px lower. The claim is in CSS pixels; the monitor is this
+  // identity's screen at its devicePixelRatio, so the ratio of the two
+  // heights scales it.
+  if (GdkIsX11Display() &&
+      MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows &&
+      MaskConfig::HostOS() != MaskConfig::SpoofedOS::Windows) {
+    auto width = MaskConfig::GetUint32("screen.width");
+    auto height = MaskConfig::GetUint32("screen.height");
+    auto avail = MaskConfig::GetRect("screen.availLeft", "screen.availTop",
+                                     "screen.availWidth", "screen.availHeight");
+    if (width && *width && height && *height && avail) {
+      const double sx = double(rect.width) / *width;
+      const double sy = double(rect.height) / *height;
+      const auto& a = *avail;
+      availRect = LayoutDeviceIntRect(
+          rect.x + NSToIntRound(a[0] * sx), rect.y + NSToIntRound(a[1] * sy),
+          NSToIntRound(a[2] * sx), NSToIntRound(a[3] * sy))
+                      .Intersect(rect);
+      LOG_SCREEN("  claimed workarea [%d, %d] -> [%d x %d]", availRect.x,
+                 availRect.y, availRect.width, availRect.height);
+    }
+  }
