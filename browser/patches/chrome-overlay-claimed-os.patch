+// Camoufox: the OS the identity claims, in nsIXULRuntime.OS's lowercase
+// form, for the camouos= modifier. A page sees the files a build for that OS
+// ships (toolkit/camoufox-overlay, generated by gen-os-overlay.py), while os=
+// keeps matching the build's own OS so the browser UI is unchanged. No claim,
+// or one no stock build makes, is the build's own OS.
+static void CamouClaimedOS(const nsAString& aHostOS, nsAString& aResult) {
+  switch (MaskConfig::GetSpoofedOS()) {
+    case MaskConfig::SpoofedOS::Windows:
+      aResult.AssignLiteral(u"winnt");
+      return;
+    case MaskConfig::SpoofedOS::Linux:
+      aResult.AssignLiteral(u"linux");
+      return;
+    case MaskConfig::SpoofedOS::MacOS:
+      aResult.AssignLiteral(u"darwin");
+      return;
+    default:
+      aResult = aHostOS;
+      return;
+  }
+}
