+/* static */
+bool nsChromeRegistry::IsPageTriggeredLoad(nsILoadInfo* aLoadInfo) {
+  if (!aLoadInfo) {
+    return false;
+  }
+  nsIPrincipal* principal = aLoadInfo->TriggeringPrincipal();
+  if (!principal || principal->IsSystemPrincipal()) {
+    return false;
+  }
+  // A sandboxed or opaque page, or an extension's content script.
+  if (principal->GetIsNullPrincipal() || principal->GetIsExpandedPrincipal()) {
+    return true;
+  }
+  if (!principal->GetIsContentPrincipal()) {
+    return false;
+  }
+  // about: pages and chrome/resource documents are the browser's own UI.
+  // Everything else with a content principal is a web page or a
+  // moz-extension page.
+  return !principal->SchemeIs("about") && !principal->SchemeIs("chrome") &&
+         !principal->SchemeIs("resource");
+}
+
+nsresult nsChromeRegistry::ConvertChromeURLForLoad(nsIURI* aChromeURI,
+                                                   nsILoadInfo* aLoadInfo,
+                                                   nsIURI** aResult) {
+  if (NS_WARN_IF(!aChromeURI)) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  if (mContentOverrideTable.Count() && IsPageTriggeredLoad(aLoadInfo)) {
+    // A query or ref must not reach the build's own file: stock serves the
+    // same file with or without one.
+    nsCOMPtr<nsIURI> key;
+    nsresult rv = NS_MutateURI(aChromeURI)
+                      .SetQuery(""_ns)
+                      .SetRef(""_ns)
+                      .Finalize(key);
+    if (NS_SUCCEEDED(rv) && mContentOverrideTable.Get(key, aResult)) {
+      return NS_OK;
+    }
+  }
+  return ConvertChromeURL(aChromeURI, aResult);
+}
