+// Camoufox: register the OS-specific about: pages a stock build for the
+// claimed OS registers, and no others. Every one of them is compiled in
+// (docshell/build/components.conf); the rest are invalidated here, in every
+// process, so a lookup fails with NS_ERROR_FACTORY_NOT_REGISTERED exactly as
+// for a module the build never had. A page can tell the two apart:
+// new Worker("about:third-party") returns for a registered module and throws
+// for an absent one. Windows registers about:third-party and
+// about:windows-messages; every other desktop OS registers about:webauthn.
+static void HideAboutPagesForClaimedOS() {
+  MaskConfig::SpoofedOS os = MaskConfig::GetSpoofedOS();
+  if (os == MaskConfig::SpoofedOS::None || os == MaskConfig::SpoofedOS::Other) {
+    os = MaskConfig::HostOS();
+  }
+  const bool windows = os == MaskConfig::SpoofedOS::Windows;
+  static const struct {
+    const char* mPage;
+    bool mWindowsOnly;
+  } kPages[] = {
+      {"third-party", true},
+      {"windows-messages", true},
+      {"webauthn", false},
+  };
+  for (const auto& page : kPages) {
+    if (page.mWindowsOnly == windows) {
+      continue;
+    }
+    // NS_ABOUT_MODULE_CONTRACTID_PREFIX (nsIAboutModule.idl)
+    nsAutoCString contractID("@mozilla.org/network/protocol/about;1?what="_ns);
+    contractID.Append(page.mPage);
+    StaticComponents::InvalidateContractID(contractID);
+  }
+}
