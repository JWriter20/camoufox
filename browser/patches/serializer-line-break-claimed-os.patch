   return rv;
 }
 
+// Camoufox: a content document whose context claims Windows serializes with
+// Windows' line break. With neither OutputCRLineBreak nor OutputLFLineBreak
+// the serializers use the platform's NS_LINEBREAK, "\r\n" on Windows, so stock
+// Windows Firefox's Selection.toString(), copied and dragged text/plain and
+// text/html break lines with CRLF where a Linux build uses LF. cfparity's
+// input.mouse.select on win-i9 (Firefox 158.0.1): a selection over three lines
+// of a white-space:pre <p> read "delta\r\necho", a Linux build claiming
+// Windows "delta\necho".
+static uint32_t ClaimedOSLineBreakFlags(mozilla::dom::Document* aDocument,
+                                        uint32_t aFlags) {
+  constexpr uint32_t kBreaks = nsIDocumentEncoder::OutputCRLineBreak |
+                               nsIDocumentEncoder::OutputLFLineBreak;
+  if ((aFlags & kBreaks) || !aDocument || aDocument->IsInChromeDocShell() ||
+      MaskConfig::HostOS() == MaskConfig::SpoofedOS::Windows ||
+      mozilla::dom::NavigatorManager::GetSpoofedOS(
+          mozilla::dom::RoverfoxStorageManager::UserContextId(aDocument)) !=
+          MaskConfig::SpoofedOS::Windows) {
+    return aFlags;
+  }
+  return aFlags | kBreaks;
+}
+
 nsDocumentEncoder::~nsDocumentEncoder() = default;
 
 NS_IMETHODIMP
@@ -738,7 +763,7 @@
 
   mMimeType = aMimeType;
 
-  mFlags = aFlags;
+  mFlags = ClaimedOSLineBreakFlags(aDocument, aFlags);
   mIsCopying = false;
 
   return NS_OK;
@@ -1749,7 +1774,7 @@
 
   // Make all links absolute when copying
   // (see related bugs #57296, #41924, #58646, #32768)
-  mFlags = aFlags | OutputAbsoluteLinks;
+  mFlags = ClaimedOSLineBreakFlags(aDocument, aFlags) | OutputAbsoluteLinks;
 
   if (!mDocument->IsScriptEnabled()) mFlags |= OutputNoScriptContent;
 
