 /* Stagger windows of the same type so they don't appear on top of each other.
    This code does have a scary double loop -- it'll keep passing through
    the entire list of open windows until it finds a non-collision. Doesn't
@@ -2439,8 +2481,36 @@ void AppWindow::SizeShell() {
   // on the resolution of the screen we're on. But positioning needs to
   // know the size so that it can constrain to screen bounds.... as an
   // initial guess here, we'll use the specified size (if any).
-  bool positionSet =
-      !mIgnoreXULPosition && LoadPositionFromXUL(specWidth, specHeight);
+  bool positionSet = !mIgnoreXULPosition;
+
+#if defined(XP_UNIX) && !defined(XP_MACOSX)
+  // Camoufox: leave independent top-level windows where the window manager
+  // puts them, which is what Firefox did here until bug 2070008 (157). Nobody
+  // places an automation browser's window by hand, so honouring the persisted
+  // XUL position makes window.screenX/screenY a function of leftover profile
+  // state: the same identity reports one position from a throwaway profile and
+  // another from a persistent one, which correlates the two sessions. It also
+  // moves the browser rect that MouseDispatch.js measures (docs/input-dispatch.md).
+  // Dependent windows still get placed relative to their parent.
+  if (!parentWindow) {
+    positionSet = false;
+    // A Windows identity's window still lands where Windows Firefox puts a
+    // second window: 22 CSS px right of and below the browser window it would
+    // otherwise cover (StaggerPosition; stock 158 on win-i9, window.open
+    // without left/top, at every scale from 100 to 250 %). Stock starts from
+    // the persisted position, which a fresh profile has at the first
+    // window's; this starts from that window itself, so no profile state
+    // reaches screenX/screenY.
+    if (MaskConfig::GetSpoofedOS() == MaskConfig::SpoofedOS::Windows &&
+        MaskConfig::HostOS() != MaskConfig::SpoofedOS::Windows) {
+      StaggerFromOtherWindow(specWidth, specHeight);
+    }
+  }
+#endif
+
+  if (positionSet) {
+    positionSet = LoadPositionFromXUL(specWidth, specHeight);
+  }
 
