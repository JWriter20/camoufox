+// Camoufox: StaggerPosition from the first other window of this type's
+// current position, for an independent window that LoadPositionFromXUL does
+// not place (see SizeShell).
+void AppWindow::StaggerFromOtherWindow(int32_t aSpecWidth,
+                                       int32_t aSpecHeight) {
+  nsCOMPtr<nsIWindowMediator> wm(do_GetService(NS_WINDOWMEDIATOR_CONTRACTID));
+  RefPtr<dom::Element> root = GetWindowDOMElement();
+  if (!wm || !root) {
+    return;
+  }
+  nsAutoString windowType;
+  root->GetAttr(nsGkAtoms::windowtype, windowType);
+  nsCOMPtr<nsISimpleEnumerator> windows;
+  wm->GetAppWindowEnumerator(windowType.get(), getter_AddRefs(windows));
+  if (!windows) {
+    return;
+  }
+  nsCOMPtr<nsIAppWindow> self(this);
+  bool more = false;
+  while (NS_SUCCEEDED(windows->HasMoreElements(&more)) && more) {
+    nsCOMPtr<nsISupports> next;
+    windows->GetNext(getter_AddRefs(next));
+    nsCOMPtr<nsIAppWindow> other(do_QueryInterface(next));
+    nsCOMPtr<nsIBaseWindow> otherBase(do_QueryInterface(next));
+    if (!otherBase || other == self) {
+      continue;
+    }
+    DesktopIntPoint point = RoundedToInt(
+        otherBase->GetPosition() / otherBase->DevicePixelsPerDesktopPixel());
+    const CSSIntSize size =
+        aSpecWidth > 0 && aSpecHeight > 0
+            ? CSSIntSize(aSpecWidth, aSpecHeight)
+            : RoundedToInt(GetPositionAndSize().Size() /
+                           UnscaledDevicePixelsPerCSSPixel());
+    StaggerPosition(point.x.value, point.y.value, size.width, size.height);
+    mWindow->ConstrainPosition(point);
+    SetPositionDesktopPix(point.x, point.y);
+    return;
+  }
+}
